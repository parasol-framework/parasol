@Package(name="gui/toggle", version="1.0")

--[[
The gui.toggle API creates and manages toggles in the user interface.

Documentation is available in the Kotuku Wiki.
--]]

   import 'gui'

   namespace gui

FONT_MAX_HEIGHT, FONT_HEIGHT = gui.getFontHeight(gui.fonts.widget)
DEFAULT_HEIGHT <const> = math.floor(FONT_MAX_HEIGHT * 1.25) + 1

function toggleState()
   if &value is 1 then
      &value = 0
      &iconRender.opacity = 0.25
   else
      &value = 1
      &iconRender.opacity = 1.0
   end

   &events?.activate()
end

gui.toggle = function(Options)
   self = entity { -- Public interface
      events         = Options.events ?? { },
      labelPos       = Options.labelPos ?? 'right',
      parentViewport = Options.target,
      text           = nil, -- A VectorText that represents the string
      value          = Options.value ?? 0,
      viewport       = nil, -- The toggle's primary viewport
   }

   -- Change the active state of the toggle to disabled or enabled

   self.disable = function()
      &disabled = true
      &viewport.acDisable()
      gui.applyStyle(&bkgd, &theme.disabled)
      &events?.disable()
      &viewport.acDraw()
   end

   self.enable = function()
      &disabled = false
      &viewport.acEnable()
      gui.applyStyle(&bkgd, &theme.bkgd)
      &events?.enable()
      &viewport.acDraw()
   end

   -- Main entry point --

   using self do
      assert(Options.target, 'A target viewport is required.')
      assert((&labelPos is 'left') or (&labelPos is 'right'), f"Invalid labelPos '{&labelPos}'")

      theme = gui.getTheme(&parentViewport)
      &theme = theme.input

      -- The toggle is a square of the widget height, and the icon and label spacing scale with it

      HEIGHT    <const> = Options.height ?? DEFAULT_HEIGHT
      ICON_SIZE <const> = HEIGHT * 0.56
      GAP       <const> = HEIGHT * 0.35

      vps = { -- Viewport settings
         x        = Options.x,
         y        = Options.y,
         width    = Options.width,
         height   = HEIGHT,
         xOffset  = Options.xOffset,
         yOffset  = Options.yOffset
      }

      calc_width = false
      if not vps.x and not vps.xOffset then vps.x = 0 end
      if not vps.y and not vps.yOffset then vps.y = 0 end
      if not vps.width and not (vps.xOffset and vps.x) then
         vps.width = gui.sizing.widget.width
         calc_width = true
      end

      &viewport = &parentViewport.new('VectorViewport', vps)

      &bkgd = &viewport.new('VectorRectangle', table.merge({
         x = 0, y = 0, width = HEIGHT, height = '100%'
      }, &theme.bkgd))

      icon_theme = gui.rgbToIconTheme(&theme.text.fill)

      chk_icon = gui.createIcon(&viewport.scene, 'items/checkmark', ICON_SIZE, icon_theme)

      icon_margin = chk_icon.margin -- Padding around the icon's pattern tile, see gui.createIcon()

      &iconRender = &viewport.new('VectorViewport', {
         x      = ((HEIGHT - ICON_SIZE) * 0.5) - icon_margin,
         y      = ((&viewport.height - ICON_SIZE) * 0.5) - icon_margin,
         width  = ICON_SIZE + (icon_margin * 2),
         height = ICON_SIZE + (icon_margin * 2),
         fill   = chk_icon.fill,
         opacity = (function()
            return &value is 1 ? 1.0 : 0.25
         end)()
      })

      &text = &viewport.new('VectorText', table.merge({ -- Label
         x         = 0,
         y         = FONT_HEIGHT + math.floor((HEIGHT - FONT_HEIGHT) * 0.5),
         face      = gui.fonts.label.face,
         fontSize  = string.format('%.2fpt', gui.fonts.label.size),
         fontStyle = gui.fonts.label.style,
         string    = Options.label,
         lineLimit = 1
      }, theme.window.text))

      if calc_width then
         &viewport.width = HEIGHT + GAP + &text.textWidth
      end

      if &labelPos is 'left' then
         &text.x = 0
         &bkgd.x = &viewport.width - HEIGHT + (&theme.bkgd.strokeWidth * 0.5)
         &iconRender.x = &viewport.width - HEIGHT + ((HEIGHT - ICON_SIZE) * 0.5) - icon_margin
      else
         &text.x = (GAP * 2) + ICON_SIZE
      end

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS|FM_CHILD_HAS_FOCUS|FM_LOST_FOCUS, function(Viewport, Event)
         if Event is FM_LOST_FOCUS then
            gui.applyStyle(&bkgd, &theme.bkgd)
            &events?.lostFocus()
         else
            if &disabled then
               gui.applyStyle(&bkgd, &theme.bkgd)
            else
               gui.applyStyle(&bkgd, &theme.focus)
               &events?.focus()
            end
         end

         Viewport.acDraw()
      end)

      &viewport.mtSubscribeKeyboard(function(Viewport, Qualifiers, Value, Unicode)
         if not (Qualifiers has KQ_PRESSED) then return end

         if (Value is KEY_ENTER) or (Value is KEY_SPACE) or (Value is KEY_NP_ENTER) then
            toggleState()
         end
      end)

      &viewport.mtSubscribeInput(JTYPE_BUTTON, function(Viewport, Msg)
         repeat
            if Msg.type is JET_LMB and Msg.value > 0 then
               toggleState()
            end
            Msg = Msg.next
         until not Msg

         Viewport.acDraw()
      end)

      &events?.show()

      return &&
   end
end
