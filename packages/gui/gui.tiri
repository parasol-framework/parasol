         text          = { fill = gui.palette.dark.text, face = gui.fonts.input.face, fontSize = string.format('%.2fpt', gui.fonts.input.size), fontStyle = gui.fonts.input.style },
         textHighlight = { fill = gui.palette.dark.altText, face = gui.fonts.input.face, fontSize = string.format('%.2fpt', gui.fonts.input.size), fontStyle = gui.fonts.input.style },
         icon          = gui.defaultFill or 'fill(pearl)',
         iconHighlight = gui.defaultFill or 'fill(pearl)'
      },
      slider = {
         bkgd          = { fill = gui.palette.dark.mid, stroke = 'none', roundX = 4, roundY = 4, strokeWidth = 2, opacity = 1 },
         fore          = { fill = gui.palette.dark.inverse, stroke = 'none', opacity = 0.75, roundX = 4, roundY = 4, strokeWidth = 2 },
         foreHighlight = { fill = gui.palette.dark.contrast, opacity = 1 },
         foreFocus     = { stroke = gui.palette.dark.contrast, strokeWidth = 2 },
         tick          = { stroke = gui.palette.dark.text, strokeWidth = 1, opacity = 0.6 },
         disabled      = { opacity = 0.5 }
      },
      scrollbar_v = {
         bkgd          = { fill = gui.palette.dark.mid, stroke = 'none', strokeWidth = 2 },
         fore          = { fill = f'{gui.palette.dark.inverse};url(#dark_vslider)', stroke = 'none', opacity = 0.75, strokeWidth = 2 },
         foreHighlight = { fill = f'{gui.palette.dark.contrast};url(#dark_vslider)', opacity = 1 },
         thickness     = gui.pixel('18dp')
      },
      scrollbar_h = {
         bkgd          = { fill = gui.palette.dark.mid, stroke = 'none', strokeWidth = 2 },
         fore          = { fill = f'{gui.palette.dark.inverse};url(#dark_hslider)', stroke = 'none', opacity = 0.75, strokeWidth = 2 },
         foreHighlight = { fill = f'{gui.palette.dark.contrast};url(#dark_hslider)', opacity = 1 },
         thickness     = gui.pixel('18dp')
      },
      toolbar = {
