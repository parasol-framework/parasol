         groupBorder   = { stroke = gui.palette.dark.edge, strokeWidth = gui.pixel('1.5pt') },
         highlight     = { fill = gui.palette.dark.contrast },
         iconSize      = gui.pixel('16pt'),
         icon          = gui.defaultFill or 'fill(pearl)',
         iconHighlight = gui.defaultFill or 'fill(pearl)'
      },
      tooltip = {
