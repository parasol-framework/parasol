         groupBorder   = { stroke = gui.palette.light.inverse, strokeWidth = gui.pixel('1.5pt') },
         highlight     = { fill = gui.palette.light.contrast },
         iconSize      = gui.pixel('16pt'),
         icon          = gui.defaultFill or 'fill(carbon)',
         iconHighlight = gui.defaultFill or 'fill(pearl)'
      },
      tooltip = {
         bkgd = { fill = gui.palette.light.bkgd, roundX = 4, roundY = 4, strokeWidth = 2, stroke = gui.palette.light.edge },
         text = { fill = gui.palette.light.text }
      },
      desktop = {
         bkgd = 'rgb(160 160 160)'
      }
   }
}) }>
