@Package(name="gui/toolbar", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui'
   import 'gui/tooltip'
   include 'vector'

   namespace gui

lTipDelay <const> = 0.75

TI_ICON  <const> = 1
TI_BREAK <const> = 2
TI_GROUP <const> = 3

gui.toolbar = function(Options)
   local theme, tb_theme

   self = entity { -- Public interface
      host           = nil,
      viewport       = nil,  -- The main viewport for the toolbar
      _groupMargin   = 6,
      _groupCount    = 0,
      _round         = 4,
      _disabled      = false,
      _lookup        = { },
      _hasFocus      = false,
      _cellMargin    = Options.cellMargin ?? 6
   }

   function sendFeedback()
      item = self._current
      if item and item.callback and (not item.disabled) and (not self._disabled) then
         item.callback(self, item)
      end
   end

   function firstIcon():table -- Return the first item that is an icon
      item = self._first
      while ((item != nil) and (item.type != TI_ICON)) do item = item.next end
      return item
   end

   function lastIcon():table -- Return the last item that is an icon
      item = self._last
      while ((item != nil) and (item.type != TI_ICON)) do item = item.prev end
      return item
   end

   function newItem(Type, Name, ID)
      if ID and self._lookup[ID] then raise 'An item with identifier ' .. ID .. ' already exists.' end

      item = { type=Type, id=ID, name=Name, x=0, y=0, width=0, height=0 }
      if Name?? then
         item.displayName = Name
      end

      if self._last then self._last.next = item end
      item.prev = self._last
      item.next = nil
      self._last = item
      self._first ?= item

      if ID then self._lookup[ID] = item end
      return item
   end

   function cancelTipTimer()
      if self._tipTimer then
         mSys.UpdateTimer(self._tipTimer, 0)
         self._tipTimer = nil
      end
   end

   function startTipTimer()
      if self._tipTimer then -- Reset existing timer
         mSys.UpdateTimer(self._tipTimer, lTipDelay)
      else
         local err
         err, self._tipTimer = mSys.SubscribeTimer(lTipDelay, function(Elapsed, CurrentTime)
            if self._current and self._current.tip?? then
               gui.tooltip({ target=self.viewport, text=self._current.tip })
            end
            self._tipTimer = nil
            raise ERR_Terminate
         end)
      end
   end

   -- Return the toolbar item located at position (x,y)

   function getCursorItem(X, Y):table
      item = self._first
      while (item) do
         if (X >= item.x) and (X < item.x + item.width) and (Y >= item.y) and (Y <  item.y + item.height) then
            if item.type is TI_ICON then return item end
         end
         item = item.next
      end
   end

   -- Position a highlighting rectangle so that it spans the breadth of the toolbar at the item's location.

   function coverItem(Vector, Item)
      if self._horizontal then
         Vector.x      = Item.x
         Vector.y      = 0
         Vector.width  = Item.width
         Vector.height = self.viewport.height
      else
         Vector.x      = 0
         Vector.y      = Item.y
         Vector.width  = self.viewport.width
         Vector.height = Item.height
      end
   end

   -- Switch an item between its normal and highlighted fill.

   function setItemHighlight(Item, Highlight)
      if Item.icon then
         Item.icon.fill = (Highlight and Item.iconAltFill) ? Item.iconAltFill : Item.iconFill
      elseif Item.vectorText then
         Item.vectorText.fill = (Highlight and Item.textAltFill) ? Item.textAltFill : Item.textFill
      end
   end

   -- Reflect an item's disabled and selected states in its graphics.

   function updateItemState(Item)
      opacity = (self._disabled or Item.disabled) ? 0.5 : 1.0
      Item.icon?.opacity = opacity
      Item.vectorText?.opacity = opacity
      Item.vSelected?.visibility = Item.selected ? 'visible' : 'hidden'
   end

   -- Highlight selected item (for keyboard item selection)

   function highlightItem(Item)
      if (not Item) or (self._kbItem is Item) then return end

      if self._current and (self._current != Item) then
         setItemHighlight(self._current, false)
      end

      self._vHover.visibility = 'hidden'
      self._current = Item
      self._kbItem  = Item
      coverItem(self.kbIcon, Item)
      self.kbIcon.visibility = 'visible'

      self.viewport.acDraw()
   end

   function hoverUpdate(Item, StateChanged) -- Highlight items that the user hovers over.
      if (self._current is Item) and (StateChanged != true) then return end

      if self._current then
         setItemHighlight(self._current, false)
      end

      self.kbIcon.visibility = 'hidden'
      self._kbItem  = nil
      self._current = Item

      if self._current and (not self._current.disabled) and (not self._disabled) then
         self._vHover.fill = self._clicked ? self._selectFill : self._hoverFill
         setItemHighlight(Item, true)
         coverItem(self._vHover, self._current)
         self._vHover.visibility = 'visible'
      else
         self._vHover.visibility = 'hidden'
      end

      self.viewport.acDraw()
   end

   -- Main routine for arranging items within the toolbar's viewport.  It can be called again to rebuild the layout
   -- after items are added.

   function arrangeItems()
      groupOffset = 0
      if self._groupCount > 0 then
         groupOffset = self._groupMargin
      end

      cell_size = tb_theme.iconSize + (self._cellMargin * 2)

      -- Transient highlight state refers to the graphics being rebuilt, so it is reset.

      if self._current then setItemHighlight(self._current, false) end
      self._current = nil
      self._clicked = nil
      self._kbItem  = nil

      -- The _groupClip simplifies masking and 'vg' provides a container for hosting vectors.

      self._groupClip?.free()
      self._groupClip = nil
      self.vg?.free()

      if self._groupCount > 0 then
         self._groupClip = self.viewport.scene.new('VectorClip', { name='GroupMask', units='UserSpace' })
      end

      self.vg = self.viewport.new('VectorGroup', { name='ItemGroup' })

      -- Selection highlights are hosted in their own group so that they draw above the group backgrounds (which are
      -- moved to the back) and below the hover highlight.

      self._vSelection = self.vg.new('VectorGroup', { name='Selections' })
      if self._groupClip then self._vSelection.mask = self._groupClip end

      highlight_round = (self._groupCount > 0) ? 0 : self._round

      self._vHover = self.vg.new('VectorRectangle', {
         fill = self._hoverFill, x = 0, y = 0, width = 1, height = 1, visibility = 'hidden',
         roundX = highlight_round, roundY = highlight_round
      })
      if self._groupClip then self._vHover.mask = self._groupClip end

      -- The keyboard highlighter shares the hover highlight's depth so that text items, which are created later in
      -- the group, draw above it.

      self.kbIcon = self.vg.new('VectorRectangle', table.merge({
         x = 0, y = 0, width = 1, height = 1, visibility = 'hidden'
      }, tb_theme.highlight))
      if self._groupClip then self.kbIcon.mask = self._groupClip end

      item = self._first

      local x:num, y:num
      if self._horizontal then
         x = 0
         y = groupOffset
      else
         x = groupOffset
         y = 0
      end

      currentGroup = nil
      spanCount = 0
      while item do
         -- Note that groups are converted to breaks when in flush mode.
         if item.type is TI_BREAK then
            item.x = x
            item.y = y

            local seq:str
            if self._horizontal then
               item.width  = 6
               item.height = cell_size
               seq = string.format('M%f,%f l0,%f', x+(item.width-1) * 0.5, y+1, item.height)
            else
               item.width  = cell_size
               item.height = 6
               seq = string.format('M%f,%f l%f,0', x+1, y+(item.height-1) * 0.5, item.width)
            end

            dash_size = tb_theme.groupBorder.strokeWidth ?? gui.pixel('1.5pt')

            self.vg.new('VectorPath', table.merge({
               name = 'break', sequence = seq, dashArray = array<double> { dash_size, dash_size }
            }, tb_theme.groupBorder))

            if self._horizontal then
               x += item.width
            else
               y += item.height
            end
         elseif item.type is TI_GROUP then
            if not Options.flush then
               if self._horizontal then
                  x += not item.prev ? groupOffset : (tb_theme.iconSize * 0.25)
               else
                  y += not item.prev ? groupOffset : (tb_theme.iconSize * 0.25)
               end

               currentGroup = item
               spanCount = 0

               item.x = x
               item.y = y
               if self._horizontal then
                  item.height = cell_size
               else
                  item.width = cell_size
               end

               item.bkgd = self.vg.new('VectorRectangle', table.merge({
                  name = 'groupbkgd', x = x, y = y, roundX = self._round, roundY = self._round, width = 1, height = 1
               }, tb_theme.bkgd))

               item.bkgd.acMoveToBack()

               item.border = self.vg.new('VectorRectangle', table.merge({
                  name = 'grouprect', x = x, y = y, roundX = self._round, roundY = self._round, width = 1, height = 1
               }, tb_theme.groupBorder))

               if self._groupClip then
                  item.clip = self._groupClip.viewport.new('VectorRectangle', {
                     name = 'groupclip', x = x, y = y, roundX = self._round, roundY = self._round, width = 1, height = 1
                  })
               end
            end
         elseif item.type is TI_ICON then
            item.x      = x
            item.y      = y
            item.width  = cell_size
            item.height = cell_size

            if item.icon then
               item.icon.x = x + self._cellMargin
               item.icon.y = y + self._cellMargin
               item.icon.acMoveToFront()
            elseif item.displayName?? then
               fill_name = f'tbar_{self._iconTheme}'
               gui.simpleGradient(self.viewport.scene, fill_name, gui.iconThemes[self._iconTheme], 0, 0, 0, 1, 'boundingbox', true)
               item.textFill = f'url(#{fill_name})'

               if self._iconHighlight and (self._iconTheme != self._iconHighlight) then
                  alt_name = f'tbar_{self._iconHighlight}'
                  gui.simpleGradient(self.viewport.scene, alt_name, gui.iconThemes[self._iconHighlight], 0, 0, 0, 1, 'boundingbox', true)
                  item.textAltFill = f'url(#{alt_name})'
               end

               item.vectorText = self.vg.new('VectorText', {
                  x        = x + self._cellMargin,
                  face     = gui.fonts.widget.face,
                  fontSize = tb_theme.iconSize * 0.75,
                  weight   = 500,
                  fill     = item.textFill,
                  string   = item.displayName
               })

               -- Text widens its cell in horizontal toolbars.  Vertical toolbars retain a uniform column width.

               if self._horizontal then
                  err, bx, by, bw, bh = item.vectorText.mtGetBoundary(0)
                  item.width = bw + (self._cellMargin * 2)
               end
               item.vectorText.y = item.y + (item.height * 0.5) + (item.vectorText.displaySize * 0.5)
            end

            item.vSelected = self._vSelection.new('VectorRectangle', {
               fill=self._selectFill, x=0, y=0, width=1, height=1, visibility='hidden',
               roundX=highlight_round, roundY=highlight_round
            })
            coverItem(item.vSelected, item)
            updateItemState(item)

            if item.sticker then
               item.sticker.viewport.x = item.x + item.width - item.sticker.viewport.width - 1
               item.sticker.viewport.y = item.y + 1
               item.sticker.viewport.acMoveToFront()
            end

            if self._horizontal then
               x += item.width
            else
               y += item.height
            end

            spanCount++

            if currentGroup then
               item.group = currentGroup
               if self._horizontal then
                  currentGroup.width  = x - currentGroup.x
                  currentGroup.height = self.viewport.height - (groupOffset * 2)
               else
                  currentGroup.width  = self.viewport.width - (groupOffset * 2)
                  currentGroup.height = y - currentGroup.y
               end

               if currentGroup.bkgd then
                  currentGroup.bkgd.width  = currentGroup.width
                  currentGroup.bkgd.height = currentGroup.height
               end

               if currentGroup.border then
                  currentGroup.border.width  = currentGroup.width
                  currentGroup.border.height = currentGroup.height
               end

               if currentGroup.clip then
                  currentGroup.clip.width  = currentGroup.width
                  currentGroup.clip.height = currentGroup.height
               end

               if spanCount is currentGroup.span then
                  if self._horizontal then
                     x += groupOffset -- Gap between groups
                  else
                     y += groupOffset
                  end
                  currentGroup = nil
               end
            end
         end

         item = item.next
      end

      if self._arrangedSize then
         if self._horizontal then
            self.viewport.width = x
         else
            self.viewport.height = y
         end
      end
      self._arranged = true
   end

   -- Size the toolbar's breadth to suit its content, then arrange the items.

   function updateLayout()
      self._colBreadth = tb_theme.iconSize + (self._cellMargin * 2)
      if self._groupCount > 0 then
         self._colBreadth += (self._groupMargin*2)
      end

      if self._horizontal then
         self.viewport.height = self._colBreadth
      else
         self.viewport.width = self._colBreadth
      end

      arrangeItems()
   end

   -- Items added after the toolbar has been created require the layout to be rebuilt.

   function itemsChanged()
      if self._arranged then
         updateLayout()
         self.viewport.acDraw()
      end
   end

   -- Insert a visual break between items.

   self.addBreak = function():table
      if not &_first then return end -- At least one item must precede a break
      item = newItem(TI_BREAK, 'break', nil)
      itemsChanged()
      return item
   end

   -- Add a clickable item to the toolbar.  The Name acts as the item text that is displayed in the toolbar if no
   -- icon can be displayed.  Set the Tip string for a user hint during hover events.  The icon string must be in the
   -- standard format of 'category/icon'.

   self.addItem = function(ID:num!, Name:str!, Tip:str, Icon:str, Function:func!)
      item = newItem(TI_ICON, Name, ID)
      item.callback = Function

      if Tip then
         item.tip = Tip
      end

      if Icon then
         try
            info = gui.createIcon(&viewport.scene, Icon, tb_theme.iconSize, &_iconTheme)
            item.iconFill = info.fill

            if &_iconHighlight and (&_iconTheme != &_iconHighlight) then
               local info = gui.createIcon(&viewport.scene, Icon, tb_theme.iconSize, &_iconHighlight)
               item.iconAltFill = info.fill
            end

            item.icon = &viewport.new('VectorRectangle', {
               fill = info.fill, x=0, y=0, width=tb_theme.iconSize, height=tb_theme.iconSize
            })
         end
      end

      itemsChanged()
   end

   -- Create a group of items with this method.  The total number of items that will be covered by the group must be
   -- known ahead of time, then added with calls to addItem().

   self.addGroup = function(ID, Name, Span):table
      if Options.flush then
         return &addBreak()
      else
         item = newItem(TI_GROUP, Name, ID)
         item.span = Span
         &_groupCount++
         itemsChanged()
         return item
      end
   end

   -- Individual toolbar items can be disabled with this method.  Reverse this action with enableItem().

   self.disableItem = function(ID)
      item = &_lookup[ID]
      if item and (not item.disabled) then
         item.disabled = true
         updateItemState(item)
         if &_current is item then hoverUpdate(item, true) end
         &viewport.acDraw()
      end
   end

   -- Items that have been disabled can be re-enabled by calling this method.

   self.enableItem = function(ID)
      item = &_lookup[ID]
      if item and item.disabled then
         item.disabled = false
         updateItemState(item)
         if &_current is item then hoverUpdate(item, true) end
         &viewport.acDraw()
      end
   end

   -- This method will reverse a previous call to selectItem() for a given item.

   self.deselectItem = function(ID)
      item = &_lookup[ID]
      item ?! raise ERR_Search
      if item.selected then
         item.selected = false
         updateItemState(item)
         &viewport.acDraw()
      end
   end

   -- Annotate a toolbar item with a sticker.

   self.applySticker = function(ID, Content)
      item = &_lookup[ID]
      item ?! return

      sticker_size = math.floor(tb_theme.iconSize * 0.5)

      item.sticker ?= { }

      if not item.sticker.viewport then
         item.sticker.viewport = &viewport.new('VectorViewport', {
            x=item.x + item.width - sticker_size - 1, y=item.y + 1, width=sticker_size, height=sticker_size
         })

         item.sticker.bkgd = item.sticker.viewport.new('VectorEllipse', {
            cx='50%', cy='50%', radius=tb_theme.iconSize * 0.25, fill=theme.palette.prime
         })
      end

      if item.sticker.content then
         item.sticker.content.free()
         item.sticker.content = nil
      end

      if Content then
         if Content is <num> then
            if Content > 9 then
               size = math.floor(tb_theme.iconSize * 0.33)
               gui.createIcon(&viewport.scene, 'items/add', size, 'pearl', 'sticker_plus')
               item.sticker.content = item.sticker.viewport.new('VectorRectangle', {
                  fill = 'url(#sticker_plus)', x=math.floor((sticker_size - size)*0.5), y=math.floor((sticker_size - size)*0.5), width=size, height=size
               })
               return
            elseif Content < 0 then
               return
            end
         end

         if Content is <str> then
            if #Content > 1 then Content = Content.sub(0,1) end
         end

         font_size = sticker_size * 0.75
         item.sticker.content = item.sticker.viewport.new('VectorText', {
            face='Noto Sans', fontStyle='bold', fontSize=font_size,
            x=math.floor(sticker_size*0.5), y=math.floor(font_size),
            fill='white', string=Content, align='middle'
         })
      end
   end

   self.removeSticker = function(ID)
      item = &_lookup[ID]
      item ?! return
      if item.sticker then
         item.sticker.viewport.free()
         item.sticker = nil
      end
   end

   -- Mark a toolbar item as selected, which results in the toolbar item being drawn with a special
   -- background to indicate that the item is active.  This operation can be reversed at any time by calling the
   -- deselectItem() method.  If Exclusive is true, all other items are deselected.

   self.selectItem = function(ID, Exclusive)
      redraw = false
      found  = false
      item   = firstIcon()
      while item do
         if item.type is TI_ICON then
            if item.id is ID then
               found = true
               if not item.selected then
                  item.selected = true
                  updateItemState(item)
                  redraw = true
               end
            elseif Exclusive and item.selected then
               item.selected = false
               updateItemState(item)
               redraw = true
            end
         end
         item = item.next
      end

      if redraw then &viewport.acDraw() end

      found ?! raise ERR_Search
   end

   @Ordinary
   function inputFeedback(Viewport, Events) -- Internal input handler
      using self do
         ev = Events
         while ev do
            if ev.type is JET_CROSSED_IN then

            elseif ev.type is JET_CROSSED_OUT then
               cancelTipTimer()
               if &_current then
                  hoverUpdate(nil)
               end
            elseif ev.flags has JTYPE_MOVEMENT then
               if not &_clicked then -- Hover tracking is suspended while a button is held
                  item = getCursorItem(ev.x, ev.y)
                  hoverUpdate(item)

                  if item and item.tip then
                     startTipTimer()
                  else
                     cancelTipTimer()
                  end
               end
            elseif ev.flags has JTYPE_BUTTON then
               if ev.value > 0 then
                  if not &_disabled then
                     cancelTipTimer()

                     if &_current and (not &_current.disabled) and (ev.type is JET_BUTTON_1) then
                        &_clicked = &_current
                        &_clickX  = ev.x
                        &_clickY  = ev.y
                        hoverUpdate(&_current, true)
                     end
                  end
               elseif ev.type is JET_BUTTON_1 then
                  if &_clicked then
                     &_clicked = nil

                     hoverUpdate(&_current, true)

                     delta_x = ev.x - &_clickX
                     delta_y = ev.y - &_clickY
                     if delta_x < 0 then delta_x = -delta_x end
                     if delta_y < 0 then delta_y = -delta_y end

                     if (delta_x < 4) and (delta_y < 4) then
                        sendFeedback()
                     end
                  end
               end
            end

            ev = ev.next
         end
      end
   end

   @Ordinary
   function kbFeedback(Viewport, Qualifiers, Code, Unicode)
      using self do
         if Qualifiers has KQ_PRESSED then
            if (Code is KEY_ENTER) or (Code is KEY_NP_ENTER) or (Code is KEY_SPACE) then
               sendFeedback()
            elseif (Code is KEY_UP) or (Code is KEY_LEFT) then
               if &_current then
                  scan = &_current.prev
                  while scan and (scan.type != TI_ICON) do
                     scan = scan.prev
                  end
                  scan ?= lastIcon()
                  highlightItem(scan)
               else
                  highlightItem(firstIcon())
               end
            elseif (Code is KEY_DOWN) or (Code is KEY_RIGHT) then
               if &_current then
                  scan = &_current.next
                  while scan and (scan.type != TI_ICON) do
                     scan = scan.next
                  end
                  scan ?= firstIcon()
                  highlightItem(scan)
               else
                  highlightItem(firstIcon())
               end
            end
         end
      end
   end

   -- Main entry point

   using self do
      assert(Options.target, 'A target viewport is required.')

      theme = gui.getTheme(Options.target)
      tb_theme = table.merge(theme.toolbar, Options.theme, true, true)

      &_iconTheme     = tb_theme.icon
      &_iconHighlight = tb_theme.iconHighlight
      &_hoverFill     = Options.hoverFill  ?? theme.button.highlight.fill
      &_selectFill    = Options.selectFill ?? theme.palette.prime

      if Options.groupMargin then
         &_groupMargin = Options.groupMargin
         if &_groupMargin < 1 then &_groupMargin = 1 end
      end

      if Options.orientation is 'horizontal' then
         &_horizontal = true
      elseif Options.orientation is 'vertical' then
         &_horizontal = false
      else -- Default to vertical if the toolbar is anchored to both the top and bottom of the target
         &_horizontal = not (Options.y and Options.yOffset)
      end

      &host = Options.target
      &viewport = Options.target.new('VectorViewport')
      &viewport.x = Options.x ?? 0
      &viewport.y = Options.y ?? 0
      &viewport.overflow = 'hidden'

      -- The toolbar's length fits its content unless an offset or explicit length is given.  Its breadth is set by
      -- updateLayout().

      if &_horizontal then
         if Options.yOffset then
            &viewport.yOffset = Options.yOffset
         else
            &viewport.height = 1
         end

         if Options.xOffset then
            &viewport.xOffset = Options.xOffset
         else
            &viewport.width = Options.target.width - &viewport.x
            &_arrangedSize = true
         end

         if Options.width then
            &viewport.width = Options.width
            &_arrangedSize = false
         end
      else
         if Options.xOffset then
            &viewport.xOffset = Options.xOffset
         else
            &viewport.width = 1
         end

         if Options.yOffset then
            &viewport.yOffset = Options.yOffset
         else
            &viewport.height = Options.target.height - &viewport.y
            &_arrangedSize = true
         end

         if Options.height then
            &viewport.height = Options.height
            &_arrangedSize = false
         end
      end

      if Options.flush then
         &_round = 0
         &_groupMargin = 0
      end

      &viewport.init()

      &viewport.subscribe('free', function(Viewport, Args)
         if self._tipTimer then mSys.UpdateTimer(self._tipTimer, 0) end
         self = { }
      end)

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS|FM_CHILD_HAS_FOCUS|FM_LOST_FOCUS, function(Viewport, Event)
         if Event is FM_LOST_FOCUS then
            self._hasFocus = false
            if self._kbItem then
               self.kbIcon.visibility = 'hidden'
               self._kbItem  = nil
               self._current = nil
            end
         else
            self._hasFocus = true
         end

         self.viewport.acDraw()
      end)

      &viewport.mtSubscribeKeyboard(kbFeedback)

      &viewport.mtSubscribeInput(JTYPE_BUTTON | JTYPE_MOVEMENT | JTYPE_CROSSING, inputFeedback)

      Options.createItems(self)

      updateLayout()

      processing.collect()
      return &&
   end
end
