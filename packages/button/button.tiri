@Package(name="gui/button", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/tooltip'

   namespace gui

LINE_SPACING, FONT_HEIGHT = gui.getFontHeight(gui.fonts.button)
DEFAULT_HEIGHT <const> = math.floor(LINE_SPACING * 1.75) + 1
TIP_DELAY <const> = 0.75 -- Seconds that the pointer must rest on the button before its tip is shown, as for toolbars

gui.button = function(Options)
   self = entity { -- Public variables
      events         = Options.events ?? { },
      parentViewport = Options.target,
      text           = nil, -- A VectorText that represents the string
      tip            = Options.tip, -- Hover tip text; recommended for buttons that only show an icon
      viewport       = nil, -- The button's primary viewport
   }

   base_theme = gui.getTheme(self.parentViewport)
   theme = table.merge(base_theme.button, Options.theme, true, true)

   -- Icon size and text padding scale with the button height

   HEIGHT    <const> = Options.height ?? DEFAULT_HEIGHT
   ICON_SIZE <const> = HEIGHT * 0.56
   GAP       <const> = HEIGHT * 0.35

   -- The hover tip is shown when the pointer rests on the button.  The tooltip removes itself when the pointer moves.

   function cancelTip()
      if self._tipTimer then
         mSys.UpdateTimer(self._tipTimer, 0)
         self._tipTimer = nil
      end
   end

   function startTip()
      cancelTip()
      if not self.tip then return end
      err, self._tipTimer = mSys.SubscribeTimer(TIP_DELAY, function()
         self._tipTimer = nil
         if self.tip and obj.find(self._viewportID) then
            gui.tooltip({ target = self.viewport, text = self.tip })
         end
         raise ERR_Terminate
      end)
   end

   -- Change the active state of the button to disabled or enabled

   self.disable = function()
      self.disabled = true
      self.viewport.acDisable()
      gui.applyStyle(self.bkgd, theme.disabled)
      self.events?.disable(self)
      self.viewport.acDraw()
   end

   self.enable = function()
      self.disabled = false
      self.viewport.acEnable()
      gui.applyStyle(self.bkgd, theme.bkgd)
      self.events?.enable(self)
      self.viewport.acDraw()
   end

   -- Main entry point --

   assert(Options.target, 'A target viewport is required.')

   if Options.feedback then -- Backwards compatibility
      print('Replace the use of button feedback with the event equivalent.')
      self.events.activate = Options.feedback
   end

   label_offset = 0

   vps = { -- Viewport settings
      x       = Options.x,
      y       = Options.y,
      width   = Options.width,
      height  = HEIGHT,
      xOffset = Options.xOffset,
      yOffset = Options.yOffset
   }

   calc_width = false
   if not vps.x and not vps.xOffset then vps.x = 0 end
   if not vps.y and not vps.yOffset then vps.y = 0 end
   if not vps.width and not (vps.xOffset and vps.x) then
      vps.width = gui.sizing.widget.width
      calc_width = true
   end

   self.viewport = self.parentViewport.new('VectorViewport', vps)
   self._viewportID = self.viewport.id

   self.bkgd = self.viewport.new('VectorRectangle', table.merge({
      x      = theme.bkgd.strokeWidth * 0.5,
      y      = theme.bkgd.strokeWidth * 0.5,
      width  = self.viewport.width - theme.bkgd.strokeWidth,
      height = HEIGHT - theme.bkgd.strokeWidth,
      resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
         if Vector.width != Width then
            Vector.width = Width - theme.bkgd.strokeWidth
         end

         if Vector.height != Height then
            Vector.height = Height - theme.bkgd.strokeWidth
         end
      end
   }, theme.bkgd))

   if Options.icon then
      try
         icon = gui.createIcon(self.viewport.scene, Options.icon, ICON_SIZE, gui.rgbToIconTheme(theme.text.fill))

         if icon then
            self.iconRender = self.viewport.new('VectorViewport', {
               x      = GAP,
               y      = (self.viewport.height - icon.size) * 0.5,
               width  = icon.size,
               height = icon.size,
               fill   = icon.fill
            })

            label_offset = (GAP * 0.5) + ICON_SIZE
         end
      end
   end

   self._textClip = self.viewport.new('VectorViewport', {
      x = theme.bkgd.strokeWidth, y = theme.bkgd.strokeWidth,
      xOffset = theme.bkgd.strokeWidth, yOffset = theme.bkgd.strokeWidth,
      overflow = VOF_HIDDEN
   })

   if Options.text then
      self.text = self._textClip.new('VectorText', table.merge({
         x         = GAP + label_offset,
         y         = FONT_HEIGHT + math.floor((HEIGHT - FONT_HEIGHT - (theme.bkgd.strokeWidth * 2)) * 0.5),
         string    = Options.text,
         lineLimit = 1
      }, theme.text))
   end

   if calc_width then
      if Options.text then
         self.viewport.width = GAP + label_offset + self.text.textWidth + GAP
      else
         self.viewport.width = (HEIGHT - ICON_SIZE) + ICON_SIZE
         self.iconRender.x = (HEIGHT - ICON_SIZE) * 0.5
      end
   end

   self.viewport.mtSubscribeFeedback(FM_HAS_FOCUS|FM_CHILD_HAS_FOCUS|FM_LOST_FOCUS, function(Viewport:obj!, Event)
      if Event is FM_LOST_FOCUS then
         self.hasFocus = false
         gui.applyStyle(self.bkgd, theme.bkgd)
         self.events?.lostFocus(self)
      else
         if self.disabled then
            gui.applyStyle(self.bkgd, theme.bkgd)
         else
            self.hasFocus = true
            gui.applyStyle(self.bkgd, theme.focus)
            self.events?.focus(self)
         end
      end

      Viewport.acDraw()
   end)

   self.viewport.mtSubscribeKeyboard(function(Viewport:obj!, Qualifiers:num!, Value:num!, Unicode)
      if not (Qualifiers has KQ_PRESSED) then return end

      if (Value is KEY_ENTER) or (Value is KEY_SPACE) or (Value is KEY_NP_ENTER) then
         self.events?.activate(self)
      end
   end)

   self.viewport.mtSubscribeInput(JTYPE_CROSSING|JTYPE_BUTTON|JTYPE_REPEATED, function(Viewport:obj!, Msg)
      repeat
         if Msg.type is JET_CROSSED_IN then
            gui.applyStyle(self.bkgd, theme.highlight)
            startTip()
            self.events?.cursorEntry(self)
         elseif Msg.type is JET_CROSSED_OUT then
            cancelTip()
            local t = table.clone(theme.bkgd)
            if self.hasFocus then gui.applyStyle(t, theme.focus) end
            gui.applyStyle(self.bkgd, t)
            self.events?.cursorExit(self)
         elseif Msg.type is JET_LMB then
            cancelTip()
            if Msg.value > 0 then
               if not self.disabled then
                  -- Click event is triggered on release unless the button is set to pulse
                  if Msg.flags has JTYPE_REPEATED then
                     if self.pulse then
                        self.events?.activate(self)
                     end
                  else
                     self.clicked = true
                     self.clickX  = Msg.x
                     self.clickY  = Msg.y
                  end
               end
            elseif self.clicked then
               self.clicked = false
               clickX = Msg.x - self.clickX
               clickY = Msg.y - self.clickY
               if clickX < 0 then clickX = -clickX end
               if clickY < 0 then clickY = -clickY end

               if ((clickX < 4) and (clickY < 4)) or self.pulse then
                  self.events?.activate(self)
               end
            end
         end
         Msg = Msg.next
      until not Msg

      Viewport.acDraw()
   end)

   self.events?.show(self)

   return self
end
