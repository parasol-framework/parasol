@Package(name="gui/scrollbar", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui'

   namespace gui

gui.scrollbar = function(Options)
   self = entity { } -- Public interface
   lTarget     = Options.target
   lPage       = Options.page
   lView       = Options.view
   lBreadth    = Options.breadth ?? 16
   lPageMode   = 'fixed'
   lMinWidth   = 0
   lTheme      = gui.getTheme(Options.target)
   lMinSlider  = lBreadth * 1.25 -- Minimum slider length (20 pixels at the default breadth)
   lHideSlider = lBreadth * 0.75 -- A bar is hidden if its slider length cannot exceed this value

   function calcSlider(ViewLength:num!, PageLength:num!, HostLength:num!, Position:num!)
      slider_size = HostLength * (ViewLength / PageLength)

      if (PageLength <= ViewLength) then -- Hide the scrollbar if the page is smaller than the view
         return 0, 0
      end

      local offset:num
      min_size = lMinSlider
      if slider_size < min_size then -- Fixed slider calculation
         slider_size = min_size
         scale       = (PageLength - ViewLength) / (HostLength - min_size)
         offset      = Position / scale
         if slider_size + offset > HostLength then
            offset = HostLength - slider_size
            if offset < 0 then offset = 0 end
            if (slider_size + offset) > HostLength then
               slider_size = HostLength
            end
         end
      else -- Proportional slider calculation
         if (Position + ViewLength) is PageLength then
            offset = HostLength - slider_size
         else
            offset = (Position * HostLength) / PageLength
         end
         if offset < 0 then offset = 0 end
      end

      if (slider_size + offset) > HostLength then
         slider_size = HostLength - offset
      end

      return offset, slider_size
   end

   -- Reading the position of the page & view, recompute the position of the slider.

   function recalcSlidersFromView()
      if self.vbar then
         self.vbar.viewport.acMoveToFront()

         host_height = self.vbar.sliderHostVP.height
         if self.hbar?.viewport?.visibility is VIS_VISIBLE then
            host_height -= lBreadth
         end

         offset, slider_size = calcSlider(lView.height, lPage.height, host_height, -lPage.y)
         if (offset != self.vbar.slider.offset) or (slider_size != self.vbar.slider.size) then
            self.vbar.slider.offset   = offset
            self.vbar.slider.size     = slider_size
            self.vbar.sliderVP.y      = offset
            self.vbar.sliderVP.height = slider_size

            if slider_size <= lHideSlider then
               self.vbar.viewport.visibility = VIS_HIDDEN
               lView.xOffset = 0
               self.hbar?.viewport.xOffset = 0
            else
               self.vbar.viewport.visibility = VIS_VISIBLE
               lView.xOffset = self.vbar.sliderVP.width
               self.hbar?.viewport.xOffset = lBreadth
            end
         end
      end

      if self.hbar then
         self.hbar.viewport.acMoveToFront()

         offset, slider_size = calcSlider(lView.width, lPage.width, self.hbar.sliderHostVP.width, -lPage.x)
         if (offset != self.hbar.slider.offset) or (slider_size != self.hbar.slider.size) then
            self.hbar.slider.offset  = offset
            self.hbar.slider.size    = slider_size
            self.hbar.sliderVP.x     = offset
            self.hbar.sliderVP.width = slider_size

            if slider_size <= lHideSlider then
               self.hbar.viewport.visibility = VIS_HIDDEN
               lView.yOffset = 0
            else
               self.hbar.viewport.visibility = VIS_VISIBLE
               lView.yOffset = self.hbar.sliderVP.height
            end
         end
      end

      lTarget.acDraw()
   end

   function createScrollbar(Direction:str!)
      local bar:table

      if Direction is 'V' then
         vp = lTarget.new('VectorViewport', { name='VBarVP', y = 0, xOffset = 0, yOffset = 0, width = lBreadth, overflow = VOF_HIDDEN })

         bar = vp.state()
         bar_theme = lTheme.scrollbar_v ?? lTheme.scrollbar
         bar.{
            viewport     = vp,
            direction    = 'V',
            theme        = bar_theme,
            barBkgd      = bar.viewport.new('VectorRectangle', table.merge({ width = '100%', height = '100%' }, bar_theme.bkgd)),
            sliderHostVP = vp.new('VectorViewport', { name='VSliderHostVP', y = 0, width = '100%', yOffset = 0, overflow = VOF_HIDDEN }),
            sliderVP     = bar.sliderHostVP.new('VectorViewport', { name='VSliderVP', width = lBreadth, height = bar.sliderHostVP.height, overflow = VOF_HIDDEN })
         }

         -- Respond to the user dragging the slider.  Moving the page is all that is necessary; this
         -- will result in downstream callbacks making the necessary updates.

         bar.sliderVP.dragCallback = function(Viewport:obj!, X:num!, Y:num!)
            slider_height = Viewport.height
            host_height   = &vbar.sliderHostVP.height
            Y = math.clamp(Y, 0, host_height - slider_height)
            if Viewport.y is Y then return end

            if (Y != &vbar.slider.offset) or (slider_height != &vbar.slider.size) then
               pct_pos = Y / (host_height - slider_height)
               lPage.y = -math.floor((lPage.height - lView.height) * pct_pos)
               lTarget.acDraw()
            end
         end
      else
         vp = lTarget.new('VectorViewport', { name='HBarVP', x = 0, xOffset = 0, yOffset = 0, height = lBreadth })
         if &vbar?.viewport?.visibility is VIS_VISIBLE then vp.xOffset = lBreadth end

         bar = vp.state()
         bar_theme = lTheme.scrollbar_h ?? lTheme.scrollbar
         bar.{
            viewport     = vp,
            direction    = 'H',
            theme        = bar_theme,
            barBkgd      = bar.viewport.new('VectorRectangle', table.merge({ width = '100%', height = '100%' }, bar_theme.bkgd)),
            sliderHostVP = vp.new('VectorViewport', { name='HSliderHostVP', x = 0, height = '100%', xOffset = 0, overflow = VOF_HIDDEN }),
            sliderVP     = bar.sliderHostVP.new('VectorViewport', { name='HSliderVP', width = bar.sliderHostVP.height, height = lBreadth, overflow = VOF_HIDDEN })
         }

         bar.sliderVP.dragCallback = function(Viewport:obj!, X:num!, Y:num!)
            slider_width = Viewport.width
            host_width   = &hbar.sliderHostVP.width
            X = math.clamp(X, 0, host_width - slider_width)
            if Viewport.x is X then return end

            if (X != &hbar.slider.offset) or (slider_width != &hbar.slider.size) then
               pct_pos = X / (host_width - slider_width)
               lPage.x = -math.floor((lPage.width - lView.width) * pct_pos)
               lTarget.acDraw()
            end
         end
      end

      bar.slider = { viewport = bar.sliderVP }
      bar.slider.bkRect = bar.sliderVP.new('VectorRectangle', table.merge({
         width = '100%', height = '100%'
      }, bar.theme.fore))

      bar.sliderVP.mtSubscribeInput(JTYPE_CROSSING, function(Viewport:obj!, Msg)
         redraw = false
         repeat
            if Msg.type is JET_CROSSED_IN then
               gui.applyStyle(bar.slider.bkRect, bar.theme.foreHighlight)
               redraw = true
            elseif Msg.type is JET_CROSSED_OUT then
               gui.applyStyle(bar.slider.bkRect, bar.theme.fore)
               redraw = true
            end
            Msg = Msg.next
         until not Msg

         if redraw then Viewport.acDraw() end
      end)

      -- Capture user interactivity within the bar area.

      bar.sliderHostVP.mtSubscribeInput(JTYPE_BUTTON|JTYPE_REPEATED,
         function(Viewport:obj!, Msg)
            repeat
               if (Msg.type is JET_LMB) and (Msg.value > 0) then
                  if bar.direction is 'V' then
                     if Msg.y < bar.sliderVP.y then
                        &scrollPage(0, (lView.height * 0.9))
                     elseif (Msg.y > bar.sliderVP.y + bar.sliderVP.height) then
                        &scrollPage(0, -(lView.height * 0.9))
                     end
                  else
                     if Msg.x < bar.sliderVP.x then
                        &scrollPage((lView.width * 0.9), 0)
                     elseif Msg.x > bar.sliderVP.x + bar.sliderVP.width then
                        &scrollPage(-(lView.width * 0.9), 0)
                     end
                  end
               end
               Msg = Msg.next
            until not Msg
         end)
      return bar
   end

   -- Compute the distance to scroll for a wheel event along one axis.

   function wheelDelta(PageLength:num!, ViewLength:num!, Value:num!):num
      length = PageLength - ViewLength
      if length <= 0 then return 0 end
      if length > ViewLength then length = ViewLength end
      return -Value * length * 0.06
   end

   -- The slider and possibly the page need to be repositioned whenever the view is resized.

   function viewFeedback(Viewport:obj!, Event)
      px = lPage.x
      py = lPage.y
      pw = lPage.width

      if lPageMode is 'dynamic' then
         nw = lMinWidth
         if nw < lView.width then -- Maximise page width in dynamic mode
            if px != 0 then
               px = 0
               lPage.x = 0
            end
            nw = lView.width
         end

         if pw != nw then
            lPage.width = nw
            pw = nw
         end
      end

      if px + pw < lView.width then
         x = lView.width - pw
         if x > 0 then x = 0 end
         if px != x then lPage.x = math.floor(x) end
      end

      if py + lPage.height < lView.height then
         y = lView.height - lPage.height
         if y > 0 then y = 0 end
         if py != y then lPage.y = math.floor(y) end
      end

      recalcSlidersFromView()
   end

   function pageFeedback(Viewport:obj!, Event)
      recalcSlidersFromView()
   end

   function pageInput(Viewport:obj!, Events)
      ev = Events
      while ev do
         if ev.type is JET_WHEEL_X then
            delta = wheelDelta(lPage.width, lView.width, ev.value)
            if delta != 0 then self.scrollPage(delta, 0) end
         elseif ev.type is JET_WHEEL then
            delta = wheelDelta(lPage.height, lView.height, ev.value)
            if delta != 0 then self.scrollPage(0, delta) end
         end
         ev = ev.next
      end
   end

   function doSubscriptions()
      lView.mtSubscribeFeedback(FM_PATH_CHANGED, viewFeedback)
      lPage.mtSubscribeFeedback(FM_PATH_CHANGED, pageFeedback)
      lPage.mtSubscribeInput(JTYPE_EXT_MOVEMENT, pageInput)
   end

   self.scrollPage = function(DeltaX:num!, DeltaY:num!)
      current_x = lPage.x
      current_y = lPage.y
      x = current_x + DeltaX
      y = current_y + DeltaY

      if (x > 0) or (lPage.width < lView.width) then
         x = 0
      elseif (x + lPage.width < lView.width) then
         x = -lPage.width + lView.width
      end

      if (y > 0) or (lPage.height < lView.height) then
         y = 0
      elseif (y + lPage.height < lView.height) then
         y = -lPage.height + lView.height
      end

      if (x != current_x) or (y != current_y) then
         lPage.x = math.floor(x)
         lPage.y = math.floor(y)
         lTarget.acDraw()
      end
   end

   -- Clients forward key presses from their keyboard subscription.  Returns true if the key was consumed for scrolling.
   -- Arrow keys move by a line, Page Up/Down move by most of a view, Home/End move to the start or end of the page.

   self.keyPress = function(Qualifiers:num!, Code:num!):bool
      if not (Qualifiers has KQ_PRESSED) then return false end
      if Qualifiers has (KQ_CTRL | KQ_ALT | KQ_COMMAND) then return false end

      can_v = (&vbar != nil) and (lPage.height > lView.height)
      can_h = (&hbar != nil) and (lPage.width > lView.width)

      if Code is KEY_UP then
         if not can_v then return false end
         &scrollPage(0, math.max(lBreadth, lView.height * 0.1))
      elseif Code is KEY_DOWN then
         if not can_v then return false end
         &scrollPage(0, -math.max(lBreadth, lView.height * 0.1))
      elseif Code is KEY_LEFT then
         if not can_h then return false end
         &scrollPage(math.max(lBreadth, lView.width * 0.1), 0)
      elseif Code is KEY_RIGHT then
         if not can_h then return false end
         &scrollPage(-math.max(lBreadth, lView.width * 0.1), 0)
      elseif Code is KEY_PAGE_UP then
         if not can_v then return false end
         &scrollPage(0, lView.height * 0.9)
      elseif Code is KEY_PAGE_DOWN then
         if not can_v then return false end
         &scrollPage(0, -(lView.height * 0.9))
      elseif Code is KEY_HOME then
         if can_v then
            &scrollPage(0, -lPage.y)
         elseif can_h then
            &scrollPage(-lPage.x, 0)
         else
            return false
         end
      elseif Code is KEY_END then
         if can_v then
            &scrollPage(0, -lPage.height)
         elseif can_h then
            &scrollPage(-lPage.width, 0)
         else
            return false
         end
      else
         return false
      end
      return true
   end

   -- NB: As a client you can set the page height and width directly if no mode change is required.

   self.setFixedPageSize = function(Width:num!, Height:num!)
      lPageMode = 'fixed'
      if Width != lPage.width then lPage.width = Width end
      if Height != lPage.height then lPage.height = Height end
   end

   self.setDynamicPageSize = function(NominalWidth:num!, MinWidth:num, Height:num!)
      lPageMode = 'dynamic'
      lMinWidth = MinWidth ?? 0

      if NominalWidth < MinWidth then
         NominalWidth = MinWidth
      end

      if NominalWidth >= lView.width then
         lPage.width  = NominalWidth
         lPage.height = Height
      else
         lPage.width  = '100%'
         lPage.height = Height
      end
   end

   self.changeViewport = function(View, Page)
      try -- The previous view and page may have been freed already
        lView.mtSubscribeFeedback(0, viewFeedback)
        lPage.mtSubscribeFeedback(0, pageFeedback)
        lPage.mtSubscribeInput(0, pageInput)
      end
      lView = View
      lPage = Page
      recalcSlidersFromView()
      doSubscriptions()
   end

   -- Main entry point

   assert(lTarget, 'A target viewport is required.')
   assert(lPage, 'A page setting is required.')
   assert(lView, 'A view setting is required.')
   assert(lView.id != lTarget.id, 'The view and target cannot be the same.')
   assert(lPage.parent.id is lView.id, 'The page is not a child of the view.')
   assert(lView.overflow is VOF_HIDDEN, 'The overflow setting for the view must be HIDDEN.')
   assert(lView.xOffset is 0, 'The XOffset of the view must be set to zero.')
   assert(lView.yOffset is 0, 'The YOffset of the view must be set to zero.')

   using self do
      if Options.direction is 'all' then Options.direction = nil end

      if Options.direction is 'vertical' or Options.direction is nil then
         &vbar = createScrollbar('V')
      end

      if Options.direction is 'horizontal' or Options.direction is nil then
         &hbar = createScrollbar('H')
      end

      doSubscriptions()

      return &&
   end
end
