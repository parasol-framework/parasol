-- Internal support functions for listview, columnview etc

@Package(name="gui/view", version="1.0")

   import 'gui', 'gui/scrollbar'

   namespace gui

   module display as mGfx

   glItemCounter = 1

----------------------------------------------------------------------------------------------------------------------

function checkCursorImage(View:table)
   if View.pointerLocked and not View.activeZone then
      mGfx.RestoreCursor(PTC_DEFAULT, View.scene.surface)
      View.pointerLocked = nil
   end
end

-- Simplifies the process of highlighting an item.  Item can be nil for deselection.

function highlightItem(View:table!, Item:table)
   if Item is View.hItem then return end

   if Item != View.hItem then
      View.hItem?._highlightEvent(View, View.hItem, false)
   end

   View.hItem = Item
   Item?._highlightEvent(View, Item, true)
   View.viewport.acDraw()
end

function clearItems(View)
   if View.items then
      for item in values(View.items) do
         item?._free(item)
      end
   end

   View.items = { }
   View.lookup = { }
   View._contentsVersion = (View._contentsVersion ?? 0) + 1
end

----------------------------------------------------------------------------------------------------------------------
-- Membership remains in item flags.  Commit every delta before calling client code, and stop an
-- obsolete notification batch when a callback replaces contents or destroys the view.  Per-item versions suppress
-- superseded membership notifications while preserving pending notifications for unchanged items.

function selectionEligible(View:table!, Item:table):bool
   return Item != nil and not Item.hidden and View.lookup[Item._id] is Item
end

function selectionTransaction(View:table!, Wanted:table!, Lead:table, Anchor:table, Reason:str!,
   Active:table, BeforeNotify:func, Removed:table):bool
   selected = array<table>
   deselected = array<table>
   first:table = nil
   snapshot = array<table>

   for item in values(View.items) do snapshot.push(item) end
   View._selectionVersion = (View._selectionVersion ?? 0) + 1
   version = View._selectionVersion
   old_active = View.activeItem

   for item in values(snapshot) do
      local wanted = selectionEligible(View, item) and Wanted[item._id] is true
      if wanted and not View.multiSelect and first then wanted = false end
      if wanted and not first then first = item end
      if wanted != (item._selected is true) then
         item._selected = wanted
         item._selectionVersion = version
         if wanted then selected.push(item) else deselected.push(item) end
      end
   end

   View.sItem = Lead?._selected and selectionEligible(View, Lead) ? Lead : first
   View.selectionAnchor = selectionEligible(View, Anchor) ? Anchor : nil
   View.activeItem = Active

   for item in values(deselected) do item?._selectEvent(View, item) end

   for item in values(selected) do item?._selectEvent(View, item) end

   if #selected > 0 or #deselected > 0 then View.scene.surface.mtScheduleRedraw() end

   if BeforeNotify then BeforeNotify() end

   local contents_version = View._contentsVersion
   for item in values(deselected) do
      if View._contentsVersion != contents_version or not View.viewport then return false end
      if item._selectionVersion is version and not item._selected
         and (Reason is 'clear' or item is Removed or View.lookup[item._id] is item) then
         View.events?.itemDeselected(View, Reason, item)
      end
   end

   for item in values(selected) do
      if View._contentsVersion != contents_version or not View.viewport then return false end
      if item._selectionVersion is version and item._selected and View.lookup[item._id] is item then
         View.events?.itemSelected(View, Reason, item)
      end
   end

   if View._selectionVersion != version or not View.viewport then return false end
   if old_active != Active then View.events?.activeChange(View, Reason, Active) end

   return View._selectionVersion is version and View.viewport != nil
end

function currentSelection(View:table!):table
   local wanted = {}
   for item in values(View.items) do
      if item._selected and not item.hidden then wanted[item._id] = true end
   end
   return wanted
end

----------------------------------------------------------------------------------------------------------------------
-- Reasons for a reported change:
--
--   clear:     All items in the view were removed.
--   inverted:  Item automatically deselected due to an invert operation.
--   moved:     The item has been deselected due to moving position.
--   user:      Selected by user interaction (click or keypress)
--   manual:    Item was manually selected (by the application, not the user).

function reportItemActivated(View:table!, Reason, Item)
   if Item.activity then Item.activity(Item) end
   View.events?.itemActivated(View, Reason, Item)
end

----------------------------------------------------------------------------------------------------------------------

function simpleSelect(View:table!, Item)
   if selectionTransaction(View, { [Item._id]=true }, Item, Item, 'user', View.activeItem) then
      reportItemActivated(View, 'user', Item)
   end
end

function selectNext(View:table, Filter):table
   if not View.sItem then
      for item in values(View.items) do
         if (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   else
      found = false
      for item in values(View.items) do
         if item is View.sItem then
            found = true
         elseif found and (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   end
end

function selectPrev(View:table, Filter):table
   if not View.sItem then
      for i in {1 into #View.items} do
         item = View.items[#View.items - i]
         if (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   else
      found = false
      for i in {1 into #View.items} do
         item = View.items[#View.items - i]
         if item is View.sItem then
            found = true
         elseif found and (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   end
end

----------------------------------------------------------------------------------------------------------------------

gui.initView = function(Options:table!, BuildUI, NewItems)
   local scroll_direction = Options.scrollDirection ?? 'all'
   assert(scroll_direction is 'all' or scroll_direction is 'vertical' or scroll_direction is 'horizontal',
      'scrollDirection must be all, vertical or horizontal')

   vw = entity {
      lookup     = { }, -- Lookup items by ID
      activeZone = nil,
      zones      = { },
      items      = { },
      disabled   = false,
      sensitive  = Options.sensitive ?? false,
      multiSelect = Options.multiSelect is true,
      _selectionVersion = 0,
      _contentsVersion = 0,
      hItem      = nil, -- Highlighted item
      sItem      = nil, -- Selected item
      selectionAnchor = nil,
      qualifiers = 0,
      activeItem = nil,
      scene      = nil,
      viewport   = nil,
      page       = nil,
      window     = nil, -- Host of the page
      -- Utilises the 'page' theme for inner view and 'widget' for titlebars etc
      theme      = nil,
      noIcons    = Options.noIcons,
      events          = Options.events ?? {},
      top             = { },
      totalTop        = 0,
      scrollDirection = scroll_direction,
      _built          = false
   }

   -- Render callbacks run with _dispatching set.  They may update their own vectors but must not change the structure
   -- of the view.

   function assertStructural()
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
   end

   -- Shift replaces the visible range; Ctrl+Shift adds it to the existing selection.
   function selectUserItem(Item:table!, Qualifiers:num!, Toggle:bool)
      if not selectionEligible(vw, Item) then return end
      local wanted = {}
      local anchor = Item
      if vw.multiSelect and (Qualifiers has KQ_SHIFT) then
         anchor = selectionEligible(vw, vw.selectionAnchor) ? vw.selectionAnchor :
            (selectionEligible(vw, vw.sItem) ? vw.sItem : Item)
         local range_start:num = nil
         local range_end:num = nil
         for i in {0 to #vw.items} do
            if vw.items[i] is anchor then range_start = i end
            if vw.items[i] is Item then range_end = i end
         end
         if range_start > range_end then range_start, range_end = range_end, range_start end
         if Qualifiers has KQ_CTRL then wanted = currentSelection(vw) end
         for i in {range_start into range_end} do
            local item = vw.items[i]
            if not item.hidden then wanted[item._id] = true end
         end
      elseif (vw.multiSelect and (Qualifiers has KQ_CTRL)) or Toggle then
         if vw.multiSelect then wanted = currentSelection(vw) end
         wanted[Item._id] = not Item._selected
      else
         wanted[Item._id] = true
      end
      selectionTransaction(vw, wanted, Item, anchor, 'user', vw.activeItem)
   end

   function seekKeyboardItem(Start:num!, Step:num!):table
      index = Start
      while index >= 0 and index < #vw.items do
         item = vw.items[index]
         if not item.hidden then return item end
         index += Step
      end
   end

   function moveKeyboardHighlight(Step:num!)
      index = nil
      if vw.hItem then
         for i in {0 to #vw.items} do
            if vw.items[i] is vw.hItem then index = i; break end
         end
      end

      start = index is nil ? (Step > 0 ? 0 : #vw.items - 1) : math.clamp(index + Step, 0, #vw.items - 1)
      item = seekKeyboardItem(start, Step > 0 ? 1 : -1)
      if not item then item = seekKeyboardItem(start, Step > 0 ? -1 : 1) end
      if item then
         highlightItem(vw, item)
         vw.revealItem(item)
      end
   end

   function selectHighlighted(Activate:bool!, Qualifiers:num!)
      item = vw.hItem
      if not selectionEligible(vw, item) then return end
      if Activate then
         if not item._selected then
            if not selectionTransaction(vw, { [item._id]=true }, item, item, 'user', vw.activeItem) then
               return
            end
         end
         if selectionEligible(vw, item) then reportItemActivated(vw, 'user', item) end
      else
         selectUserItem(item, Qualifiers, true)
      end
   end

   vw.addItem = function(Item)
      assert(Item, 'No Item provided')
      vw.addItems({ Item })
   end

   vw.addItems = function(Items)
      assert(Items, 'No Items provided')

      new_items = { }
      for item in values(Items) do
         new_item = {
            _id = glItemCounter,
            _vectors = { },
            _free = function(Item) -- This hook can be overridden by the client
               vp = Item._vectors.viewport
               Item._vectors.viewport = nil

               for v in values(Item._vectors) do
                  v.free()
               end

               vp?.free()

               Item._vectors = { }
            end
         }

         for k, v in pairs(item) do -- Copy all item key-values supplied by the user
            new_item[k] = v
         end

         vw.items.insert(new_item)
         if NewItems then new_items.insert(new_item) end
         vw.lookup[glItemCounter] = new_item
         glItemCounter++
      end

      if vw._built and NewItems and (#new_items > 0) then
         NewItems(vw, new_items) -- Report new items to view manager
      end
   end

   -- Generic callback for the user hovering and interacting with listed items

   function itemHoverCallback(Zone, CursorX, CursorY)
      highlightItem(vw, Zone.item)

      vw.hoveredItem = {
         click = function(Input)
            if Input.value is 0 and not vw.disabled and not vw._modifiedClick then
               if vw.sensitive and (not Zone.item.insensitive) then
                  reportItemActivated(vw, 'user', Zone.item)
               elseif Input.flags has JTYPE_DBL_CLICK then
                  reportItemActivated(vw, 'user', Zone.item)
               end
            end
         end
      }
   end

   function cursorActivity()
      if not vw.activeZone and vw.cursorX then
         for zone in values(vw.zones) do
            if (vw.cursorY >= zone.y) and (vw.cursorY < zone.y + zone.height) then
               if ((not zone.width) or ((vw.cursorX >= zone.x) and (vw.cursorX < zone.x + zone.width))) then
                  cursor = zone.hoverCallback(zone, vw.cursorX, vw.cursorY)
                  if not cursor then checkCursorImage(vw) end
                  break
               end
            end
         end
      end
   end

   vw.disable = function()
      vw.disabled = true
      vw?._stateChanged()
   end

   vw.enable = function()
      vw.disabled = false
      vw?._stateChanged()
   end

   -- Add a monitored click zone.  Not for client use.
   -- If Width is nil then the click zone will span the entire width of the page and X is ignored.

   vw.addZone = function(X, Y, Width, Height, Item, HoverCallback):table
      if not HoverCallback then HoverCallback = itemHoverCallback end

      vw.zones.insert({
         x      = X,
         y      = Y,
         width  = Width,
         height = Height,
         item   = Item,
         hoverCallback = HoverCallback
      })

      return vw.zones[#vw.zones-1]
   end

   -- Clears a view of all internal content and updates the display.

   vw.clearView = function()
      if vw._clearing then return end
      vw._clearing = true
      highlightItem(vw, nil)
      local completed = selectionTransaction(vw, {}, nil, nil, 'clear', nil, function()
         clearItems(vw)
         vw._clearing = false
      end)
      if completed then vw.rebuild() end
      return completed
   end

   -- Inverts visible membership in multiple mode, retaining the sensitive-view no-op.

   vw.invertSelection = function()
      if vw.sensitive or not vw.multiSelect then return end
      local wanted = {}
      for item in values(vw.items) do
         if not item.hidden and not item._selected then wanted[item._id] = true end
      end
      highlightItem(vw, nil)
      selectionTransaction(vw, wanted, nil, vw.selectionAnchor, 'inverted', nil)
   end

   -- Returns the graphical dimensions of an item in the view.

   vw.itemDimensions = function(Item)
      assert(Item, 'No Item provided')
      vp = Item._vectors?.viewport
      if not vp then return { x=0, y=0, width=0, height=0 } end
      return { x=vp.x ?? 0, y=vp.y ?? 0, width=vp.width ?? 0, height=vp.height ?? 0 }
   end

   -- Moves an item towards the bottom of the view.

   vw.lowerItem = function(Item)
      assert(Item, 'No Item provided')
      for i in {0 to #vw.items - 1} do
         if vw.items[i] is Item then
            vw.items[i] = vw.items[i+1]
            vw.items[i+1] = Item
            vw.rebuild()
            return
         end
      end
   end

   -- Moves an item towards the top of the view.

   vw.raiseItem = function(Item)
      assert(Item, 'No Item provided')
      for i in {1 to #vw.items} do
         if vw.items[i] is Item then
            vw.items[i] = vw.items[i-1]
            vw.items[i-1] = Item
            vw.rebuild()
            return
         end
      end
   end

   -- Removes an item from the view.

   vw.removeItem = function(Item)
      assert(Item, 'No Item provided')

      if vw.lookup[Item._id] != Item then return end
      if Item is vw.hItem then highlightItem(vw, nil) end
      local wanted = currentSelection(vw)
      wanted[Item._id] = nil
      local active = vw.activeItem is Item ? nil : vw.activeItem
      local completed = selectionTransaction(vw, wanted, vw.sItem,
         vw.selectionAnchor is Item ? nil : vw.selectionAnchor, 'manual', active, function()
            for i in {0 to #vw.items} do
               if vw.items[i] is Item then vw.items.remove(i); break end
            end
            vw.lookup[Item._id] = nil
            Item._free(Item)
         end, Item)
      if completed then vw.rebuild() end
   end

   -- Checks the visibility of an item, scrolling it into view if it is partially or fully hidden.

   vw.revealItem = function(Item)
      assert(Item, 'No Item provided')
      if not vw.scrollbar then return end

      dims = vw.itemDimensions(Item)
      if (dims.width <= 0) and (dims.height <= 0) then return end

      scroll_top    = -vw.page.y
      scroll_bottom = scroll_top + vw.frame.height

      delta_y = 0
      if dims.y < scroll_top then
         delta_y = scroll_top - dims.y
      elseif dims.y + dims.height > scroll_bottom then
         delta_y = scroll_bottom - (dims.y + dims.height)
      end

      scroll_left  = -vw.page.x
      scroll_right = scroll_left + vw.frame.width

      delta_x = 0
      if dims.x < scroll_left then
         delta_x = scroll_left - dims.x
      elseif dims.x + dims.width > scroll_right then
         delta_x = scroll_right - (dims.x + dims.width)
      end

      if (delta_x != 0) or (delta_y != 0) then
         vw.scrollbar.scrollPage(delta_x, delta_y)
      end
   end

   -- Selects all items in the view for the user.

   function selectAllVisible(Reason:str!)
      local wanted = currentSelection(vw)
      local lead = selectionEligible(vw, vw.sItem) and vw.sItem._selected ? vw.sItem : nil
      for item in values(vw.items) do
         if not item.hidden and (vw.multiSelect or not lead) then
            wanted[item._id] = true
            lead ?= item
         end
      end
      selectionTransaction(vw, wanted, lead, vw.selectionAnchor, Reason, lead)
   end

   vw.selectAll = function()
      selectAllVisible('manual')
   end

   -- Add visible matches in multiple mode, or replace with the first match in single mode.

   vw.selectItems = function[](Conditional:func)
      local wanted = vw.multiSelect ? currentSelection(vw) : {}
      local lead:table = nil

      for item in values(vw.items) do
         if not item.hidden and Conditional(item) is true then
            wanted[item._id] = true
            lead = item
            if not vw.multiSelect then break end
         end
      end

      if lead then selectionTransaction(vw, wanted, lead, vw.selectionAnchor, 'manual', lead) end
   end

   -- Return a table of all selected items

   vw.selectedItems = function():array<table>
      list = array<table> { }
      for item in values(vw.items) do
         if item._selected then
            list.push(item)
         end
      end
      return list
   end

   vw.selectNext = function(Filter)
      Filter ?= function() return true end
      selectNext(vw, Filter)
   end

   vw.selectPrev = function(Filter)
      Filter ?= function() return true end
      selectPrev(vw, Filter)
   end

   -- Deselects all currently selected items.

   vw.deselectAll = function()
      selectionTransaction(vw, {}, nil, nil, 'manual', nil)
   end

   vw.free = function()
      if vw._freeing then return end
      vw._freeing = true
      vw.clearView()
      vw.viewport?.free()
      for k,v in pairs(vw) do vw[k] = nil end
      processing.collect()
   end

   -- Changes the underlying attributes of any item in the view by setting provided key-values.

   vw.setItem = function(Item:table!, KV:table!)
      for k, v in pairs(KV) do
         Item[k] = v
      end

      vw.rebuild()
   end

   -- Load a new set of items and display them for the user.  Any existing items will be cleared.

   vw.loadItems = function(Items)
      if not vw.clearView() or not vw.viewport then return end
      vw.addItems(Items)
      vw.rebuild()
   end

   -- Internal function for sorting items by any named attribute.  Clients must call sort() instead.

   vw.sortItems = function(Attrib, Ascending)
      Attrib ?= 'name'
      Ascending ?= true

      if #vw.items <= 1 then return end

      if vw.items[0][Attrib] is <table> then
         if vw.items[0][Attrib]['sort'] then
            vw.items.sort(function(a,b)
               return Ascending ? (a[Attrib].sort < b[Attrib].sort) : (a[Attrib].sort > b[Attrib].sort)
            end)
         else
            vw.items.sort(function(a,b)
               return Ascending ? (a[Attrib].value < b[Attrib].value) : (a[Attrib].value > b[Attrib].value)
            end)
         end
      elseif vw.items[1][Attrib] is <str> then
         vw.items.sort(function(a,b)
            return Ascending ? (string.lower(a[Attrib]) < string.lower(b[Attrib])) :
               (string.lower(a[Attrib]) > string.lower(b[Attrib]))
         end)
      else
         vw.items.sort(function(a,b)
            return Ascending ? a[Attrib] < b[Attrib] : a[Attrib] > b[Attrib]
         end)
      end

      vw.scene.surface.mtScheduleRedraw()
   end

   -- Sort items by any named attribute (Attrib must appear in all items)
   -- Functionality must be defined by the host.

   vw.sortView = function(Attrib, Ascending)
      msg('The view implementation must override the sort() method.')
   end

   -- Internal function for building the view's UI

   vw.rebuild = function()
      if not selectionTransaction(vw, currentSelection(vw), vw.sItem, vw.selectionAnchor,
         'manual', vw.activeItem) then return end
      if vw.hItem and not selectionEligible(vw, vw.hItem) then highlightItem(vw, nil) end
      vw.zones = { }
      vw.hoveredItem = { }

      vw.page.x = 0 -- Reset the page position
      vw.page.y = 0

      BuildUI(vw)
      vw._built = true
      cursorActivity() -- Reset the cursor
      vw.border?.acMoveToFront()
      vw.scene.surface.mtScheduleRedraw()
   end

   -- Internal function for offsetting the frame, e.g. to accommodate a toolbar.

   vw.reserveTop = function(ID, Height)
      if vw.top[ID] then return end
      vw.top[ID] = { y=vw.totalTop, height=Height }
      vw.totalTop = vw.totalTop + Height
      vw.frame?.y = vw.totalTop
      vw.scrollbar?.vbar?.viewport.y = vw.totalTop
   end

   -- Initialisation --

   vw.parentViewport = Options.target

   vw.scene    = vw.parentViewport.scene
   vw.viewport = vw.parentViewport.new('VectorViewport', { name='view_main', overflow='hidden' }) -- Main viewport for vector graphics.
   vw.frame    = vw.viewport.new('VectorViewport', { name='view_frame', x=0, xOffset=0, y=0, yOffset=0, overflow=VOF_HIDDEN })
   vw.theme    = gui.getTheme(vw.scene)
   if Options.theme then -- Accepts page and widget theme config
      vw.theme = table.merge(vw.theme, Options.theme, true, true)
   end

   vw.bkgd = vw.frame.new('VectorRectangle', table.merge({
      name = 'view_bkgd', width = '100%', height = '100%'
   }, vw.theme.page.bkgd))

   vw.page = vw.frame.new('VectorViewport', { name='view_page', width='100%', height='100%', buffered=true })

   if not Options.borderless then
      vw.border = vw.viewport.new('VectorRectangle', table.merge({
         name = 'view_border', x = 0.5, y = 0.5, xOffset = -0.5, yOffset = -0.5,
      }, vw.theme.page.border))
   end

   for v in values(array<str> { 'x', 'y', 'xOffset', 'yOffset', 'width', 'height'}) do
      if Options[v] then vw.viewport[v] = Options[v] end
   end

   vw.parentViewport.subscribe('free', function(Surface, Args)
      vw.parentViewport = nil
   end)
--[[
   vw.parentViewport.mtSubscribeFeedback((FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS), function(Viewport, Event)
      if (Event is FM_LOST_FOCUS) then

      else

      end
   end)
--]]

   vw.scrollbar = gui.scrollbar({
      target    = vw.viewport,
      view      = vw.frame,
      page      = vw.page,
      direction = 'all'
   })

   if not Options.borderless and vw.scrollbar then
      vw.scrollbar.hbar?.viewport.x = 1
      vw.scrollbar.vbar?.viewport.y = 1
   end

   vw.viewport.mtSubscribeFeedback((FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS), function(Viewport, Event)
      if Event is FM_LOST_FOCUS then
         vw.hasFocus = false
         vw.qualifiers = 0
         vw.events?.lostFocus(vw)
      else
         vw.hasFocus = true
         vw.events?.focus(vw)
      end
      vw?._stateChanged()
      vw.viewport.acDraw()
   end)

   -- Pointer input has no qualifiers.  Track them independently of vector focus so that Ctrl/Shift
   -- pressed in another widget still apply to the first click here.
   vw._modifierKeyboard = input.keyboard(nil, function(Handle, SurfaceID, Qualifiers, Code, Unicode)
      vw.qualifiers = Qualifiers & (KQ_SHIFT | KQ_CTRL)
      if Qualifiers has KQ_RELEASED then
         if Code is KEY_L_SHIFT then vw.qualifiers = vw.qualifiers & ~KQ_L_SHIFT end
         if Code is KEY_R_SHIFT then vw.qualifiers = vw.qualifiers & ~KQ_R_SHIFT end
         if Code is KEY_L_CONTROL then vw.qualifiers = vw.qualifiers & ~KQ_L_CONTROL end
         if Code is KEY_R_CONTROL then vw.qualifiers = vw.qualifiers & ~KQ_R_CONTROL end
      end
   end)
   vw.viewport.subscribe('free', function()
      vw._modifierKeyboard?.unsubscribe()
      vw._modifierKeyboard = nil
   end)

   vw.viewport.mtSubscribeKeyboard(function(Viewport, Qualifiers, Code, Unicode)
      if (Qualifiers has KQ_PRESSED) and not vw.disabled then
         if vw._keyEvent and vw._keyEvent(Qualifiers, Code, Unicode) then return end
         if (Code is KEY_ENTER) or (Code is KEY_NP_ENTER) then
            selectHighlighted(true, Qualifiers)
         elseif Code is KEY_A and (Qualifiers has KQ_CTRL) then
            if vw.multiSelect then selectAllVisible('user') end
         elseif Code is KEY_SPACE then
            selectHighlighted(false, Qualifiers)
         elseif (Code is KEY_UP) or (Code is KEY_LEFT) then
            moveKeyboardHighlight(-1)
            if vw.hItem and (Qualifiers has KQ_SHIFT) then selectUserItem(vw.hItem, Qualifiers) end
         elseif (Code is KEY_DOWN) or (Code is KEY_RIGHT) then
            moveKeyboardHighlight(1)
            if vw.hItem and (Qualifiers has KQ_SHIFT) then selectUserItem(vw.hItem, Qualifiers) end
         elseif Code is KEY_HOME then
            item = seekKeyboardItem(0, 1)
            if item then
               highlightItem(vw, item)
               vw.revealItem(item)
               if Qualifiers has KQ_SHIFT then selectUserItem(item, Qualifiers) end
            end
         elseif Code is KEY_END then
            item = seekKeyboardItem(#vw.items - 1, -1)
            if item then
               highlightItem(vw, item)
               vw.revealItem(item)
               if Qualifiers has KQ_SHIFT then selectUserItem(item, Qualifiers) end
            end
         end
      end
   end)

   vw.page.mtSubscribeInput((JTYPE_MOVEMENT | JTYPE_BUTTON | JTYPE_CROSSING | JTYPE_EXT_MOVEMENT), function(Viewport, Events)
      ev = Events
      while ev do
         if ev.type is JET_CROSSED_IN then
            vw.cursorX = ev.x
            vw.cursorY = ev.y
            checkCursorImage(vw)
         elseif ev.type is JET_CROSSED_OUT then
            vw.cursorX = nil
            vw.cursorY = nil
            checkCursorImage(vw)
            if vw.hItem then
               highlightItem(vw, nil)
            end
         elseif ev.type is JET_BUTTON_1 then
            if vw.disabled or (ev.flags has JTYPE_REPEATED) then return end
            if ev.value is 1 then vw._modifiedClick = vw.qualifiers has (KQ_SHIFT | KQ_CTRL) end

            if ev.value is 1 then
               vw.clickAbsX = ev.absX
               vw.clickAbsY = ev.absY
               vw.clickX = ev.x
               vw.clickY = ev.y
            end

            if vw.activeZone then -- Custom zone for click activity
               vw.activeZone?.clickRelease(ev.x, ev.y, ev.absX, ev.absY)
               vw.activeZone = nil
               cursorActivity()
               return
            end

            if vw._itemClick and vw._itemClick(vw.hItem, ev) then
               ev = ev.next
               continue
            end

            if vw.hoveredItem and vw.hoveredItem.click then -- Feedback for all click types.  Refer to hoveredItem()
               if vw.hoveredItem.click(ev) then
                  return
               end
            end

            if (ev.value is 1) and vw.hItem then
               if not vw.disabled then selectUserItem(vw.hItem, vw.qualifiers) end
            end
         elseif ev.type is JET_ABS_XY then
            vw?.activeZone?.clickMove(ev)
            vw.cursorX = ev.x
            vw.cursorY = ev.y
            vw.cursorAbsX = ev.absX
            vw.cursorAbsY = ev.absY
            cursorActivity()
         end
         ev = ev.next
      end
   end)

   if Options.items then
      vw.addItems(Options.items)
   end

   vw.rebuild()

   return vw
end
