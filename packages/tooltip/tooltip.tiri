@Package(name="gui/tooltip", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui'
   include 'display', 'vector'

   namespace gui

gui.tooltip = function(Options)
   local self = entity { } -- Public variables

   using self do
      theme = Options.theme ?? gui.getTheme(Options.target)

      &free = function()
         local surface = &surface
         &surface = nil
         surface?.free()
      end

      local ptr = obj.find('systempointer')

      &surface = obj.new('surface', {
         name = 'rgnTip',
         x = ptr.x + 6, y = ptr.y, width = 300,
         parent = 0, presence = SPT_NONE,
         flags = RNF_STICK_TO_FRONT | RNF_COMPOSITE
      })

      &surface.detach()

      &scene = &surface.new('VectorScene', { flags=VPF_RESIZE, surface=&surface })

      &viewport = &scene.new('VectorViewport', { })

      &box = &viewport.new('VectorRectangle', table.merge({
         x = 1, y = 1, height = '100%', width = '100%',
         roundX = 4, roundY = 4,
         resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
            Vector.width  = Width - (Vector.x * 2)
            Vector.height = Height - (Vector.y * 2)
         end
      }, table.merge(theme.page.bkgd, theme.page.border)))

      &text = &viewport.new('VectorText', table.merge({
         x         = gui.fonts.button.size,
         string    = Options.text,
         face      = gui.fonts.button.face,
         fontStyle = gui.fonts.button.style,
         fontSize  = string.format('%.2fpt', gui.fonts.button.size),
         textFlags = VTXF_RASTER
      }, theme.page.text))

      &surface.height = (gui.fonts.button.size*1.5) + tonumber(&text.fontSize)
      &surface.y = ptr.y - &surface.height
      &text.y = math.floor((&viewport.height * 0.5) + (&text.displaySize * 0.5))

      -- This code segment attaches to the surface so that it works independently of the client.  It
      -- terminates the tooltip when the pointer is moved by the user.

      local script = &surface.new('tiri', { name='tiriTip', statement=[[
         include 'display'
         surface_id = tonumber(arg('surface'))
         surface = obj.find(surface_id)
         if surface then
            input.subscribe(JTYPE_MOVEMENT | JTYPE_BUTTON, nil, 0, function(Input, Message)
               Input.unsubscribe()
               surface.free()
            end)
         end
      ]] })

      script.setKey('surface', &surface.id)
      script.acActivate()

      -- Reduce the width of the tooltip if the text is short.

      if (&surface.width > &text.textWidth + (gui.fonts.button.size * 2)) then
         &surface.width = (gui.fonts.button.size * 2) + &text.textWidth
      end

      -- Adjust the position of the tool tip so that it fits on the screen.
   --[[
      if systemSurface != nil then
         if &surface.right > systemSurface.width then
            &surface.x = ptr.x - &surface.width
         end
      end
   --]]

      if &surface.y < 0 then
         &surface.y = ptr.y + 20
      end

      &surface.acShow()

      return &&
   end
end
