@Package(name="gui/slider", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui'

   namespace gui

FONT_MAX_HEIGHT, FONT_HEIGHT = gui.getFontHeight(gui.fonts.widget)
DEFAULT_THICKNESS <const> = math.floor(FONT_MAX_HEIGHT * 1.35) + 1
MARGIN <const> = math.floor(FONT_HEIGHT * 0.5) + 1

gui.slider = function(Options:table!)
   min = (Options.min != nil) ? Options.min : 0
   max = (Options.max != nil) ? Options.max : 1

   self = setmetatable(entity {
      min    = min,
      max    = max,
      step   = (Options.step != nil) ? Options.step : 0,
      value  = (Options.value != nil) ? Options.value : min + ((max - min) * 0.5),
      label  = Options.label,
      thickness = Options.thickness ?? DEFAULT_THICKNESS, -- Breadth of the slider, which is also the thumb's box size
      events = Options.events ?? { },
      viewport = nil,
      disabled = false,
      hasFocus = false,
      prvHover = false,
      setRange = function(Min:num!, Max:num!)
         assert(Max > Min, 'The min/max values are invalid.')
         &min = Min
         &max = Max
         &prvPlaceSlider()
         &viewport.scene.surface.mtScheduleRedraw()
         &setValue(&value) -- Clamp and snap the existing value to the new range
      end,

      -- Change the active state of the slider.  A disabled slider ignores pointer and keyboard input.

      disable = function()
         &disabled = true
         &viewport.acDisable()
         &prvHover = false
         &prvApplyStyle()
         &viewport.acDraw()
         &events?.disable()
      end,

      enable = function()
         &disabled = false
         &viewport.acEnable()
         &prvApplyStyle()
         &viewport.acDraw()
         &events?.enable()
      end,

      prvApplyStyle = function()
         theme = &prvTheme.slider
         gui.applyStyle(&prvBarBkgd, table.merge({ opacity = 1 }, theme.bkgd))
         gui.applyStyle(&button, theme.fore)
         if &disabled then
            gui.applyStyle(&prvBarBkgd, theme.disabled)
         else
            if &prvHover then gui.applyStyle(&button, theme.foreHighlight) end
            if &hasFocus then gui.applyStyle(&button, theme.foreFocus) end
         end
      end,

      setValue = function(Value:num)
         Value = &prvSnap(Value)
         if Value is &value then return end
         &value = Value
         &prvPlaceSlider()
         &viewport.scene.surface.mtScheduleRedraw()
         &events?.activate(Value)
      end,

      -- Clamp a value to the slider range and snap it to the nearest step.  Steps are counted from min, and max is
      -- always reachable even if the range is not an exact multiple of the step.

      prvSnap = function(Value:num):num
         Value = math.clamp(Value, &min, &max)
         if &step <= 0 then return Value end
         snapped = math.min(&min + (math.round((Value - &min) / &step) * &step), &max)
         if (&max - Value) < (Value - snapped) then snapped = &max end
         return snapped
      end,

      -- Convert a slider position within the track to a value.  Vertical sliders place max at the top.

      prvTrackValue = function(Position:num):num
         if &orientation is 'V' then
            track = &prvSliderHostVP.height - &thickness
            return &min + ((&max - &min) * math.clamp((track - Position) / track, 0, 1))
         else
            track = &prvSliderHostVP.width - &thickness
            return &min + ((&max - &min) * math.clamp(Position / track, 0, 1))
         end
      end,

      prvPlaceSlider = function()
         fraction = (&value - &min) / (&max - &min)
         if &orientation is 'V' then
            track = &prvSliderHostVP.height - &thickness
            &prvSliderVP.y = track - (fraction * track)
         else
            &prvSliderVP.x = fraction * (&prvSliderHostVP.width - &thickness)
         end
      end
   }, {
      __gc = function()
         &viewport?.free()
         &viewport = nil
      end
   })

   using self do
      target = Options.target
      assert(target, 'A target viewport is required.')
      assert(&max > &min, 'The min/max values are invalid.')
      assert(&step >= 0, 'The step value cannot be negative.')

      base_theme = gui.getTheme(target)
      &prvTheme = Options.theme ? table.merge(base_theme, { slider = table.merge(base_theme.slider, Options.theme, true, true) }) : base_theme
      &orientation = (Options.orientation is 'vertical') ? 'V' : 'H'
      &prvLabelSize = 0
      &value = &prvSnap(&value)

      if &orientation is 'V' then
         &viewport = target.new('VectorViewport', {
            x = Options.x, y = Options.y, height = (Options.size ?? 100), width = &thickness
         })

         &prvSliderHostVP = &viewport.new('VectorViewport', { y = 0, width = '100%', yOffset = 0 })

         &prvBarBkgd = &prvSliderHostVP.new('VectorRectangle', table.merge({
            x = 0, y = 0, width = '100%', height = '100%',
         }, &prvTheme.slider.bkgd))
      else
         &viewport = target.new('VectorViewport', {
            x = Options.x, y = Options.y, width = (Options.size ?? 100), height = &thickness
         })

         if &label then
            &labelText = &viewport.new('VectorText', table.merge({
               name      = 'Label',
               x         = 0,
               y         = math.round(FONT_HEIGHT + math.floor((&thickness - FONT_HEIGHT) * 0.5)),
               face      = gui.fonts.label.face,
               fontSize  = string.format('%.2fpt', gui.fonts.label.size),
               fontStyle = gui.fonts.label.style,
               string    = &label,
               lineLimit = 1
            }, &prvTheme.window.text))

            &prvLabelSize = &labelText.textWidth + MARGIN
            &viewport.width += &prvLabelSize
         end

         &prvSliderHostVP = &viewport.new('VectorViewport', { x = &prvLabelSize, height = '100%', xOffset = 0 })

         &prvBarBkgd = &prvSliderHostVP.new('VectorRectangle', table.merge({
            x = 0, y = 0, width = '100%', height = '100%',
         }, &prvTheme.slider.bkgd))
      end

      &prvSliderVP = &prvSliderHostVP.new('VectorViewport', { width = &thickness, height = &thickness })

      -- Drag coordinates are relative to the drag origin, so snapping the slider does not impede its movement.

      &prvSliderVP.dragCallback = function(Viewport:obj!, X:num!, Y:num!)
         if &disabled then return end
         &setValue(&prvTrackValue((&orientation is 'V') ? Y : X))
      end

      &prvPlaceSlider()

      GAP <const> = &prvTheme.slider.bkgd.strokeWidth

      &button = &prvSliderVP.new('VectorRectangle', table.merge({
         x = GAP, y = GAP, width = &prvSliderVP.width-(GAP*2), height = &prvSliderVP.height-(GAP*2)
      }, &prvTheme.slider.fore))

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Viewport, Event)
         &hasFocus = Event != FM_LOST_FOCUS

         &prvApplyStyle()
         Viewport.acDraw()

         if Event is FM_LOST_FOCUS then
            &events?.lostFocus()
         elseif not &disabled then
            &events?.focus()
         end
      end)

      -- Keyboard registration makes the whole widget a single stop in the scene's tab order.  Continuous sliders
      -- use one percent of the range per arrow press; Page Up/Down move ten increments.

      &viewport.mtSubscribeKeyboard(function(Viewport:obj!, Qualifiers:num!, Code:num!, Unicode)
         if &disabled or not (Qualifiers has KQ_PRESSED) then return end

         increment = (&step > 0) ? &step : ((&max - &min) / 100)
         if (Code is KEY_RIGHT) or (Code is KEY_UP) then
            &setValue(&value + increment)
         elseif (Code is KEY_LEFT) or (Code is KEY_DOWN) then
            if (&step > 0) and (&value is &max) then
               -- The maximum can be off-grid; move to the preceding step instead of rounding past it.
               previous = &min + ((math.ceil((&max - &min) / &step) - 1) * &step)
               -- Decimal round-off can reconstruct the maximum; ensure the snapped value actually decreases.
               if &prvSnap(previous) is &max then previous -= &step end
               &setValue(previous)
            else
               &setValue(&value - increment)
            end
         elseif Code is KEY_PAGE_UP then
            &setValue(&value + (increment * 10))
         elseif Code is KEY_PAGE_DOWN then
            &setValue(&value - (increment * 10))
         elseif Code is KEY_HOME then
            &setValue(&min)
         elseif Code is KEY_END then
            &setValue(&max)
         end
      end)

      &prvSliderVP.mtSubscribeInput(JTYPE_CROSSING, function(Viewport, Msg)
         if &disabled then return end

         repeat
            if Msg.type is JET_CROSSED_IN then
               &prvHover = true
            elseif Msg.type is JET_CROSSED_OUT then
               &prvHover = false
            end
            Msg = Msg.next
         until not Msg

         &prvApplyStyle()
         Viewport.acDraw()
      end)

      &prvSliderHostVP.mtSubscribeInput(JTYPE_BUTTON,
         function(Viewport:obj!, Msg)
            repeat
               if (Msg.type is JET_LMB) and (Msg.value > 0) and (not &disabled) then -- Centre the slider on the click position
                  &setValue(&prvTrackValue(((&orientation is 'V') ? Msg.y : Msg.x) - (&thickness * 0.5)))
               end
               Msg = Msg.next
            until Msg is nil
         end)

      if Options.disabled then &disable() end
      &events?.show()
      return &&
   end
end
