-- Styling for the 'gui/slider' script.

   import 'gui'

return {
   background = function(Slider:table!, Viewport:obj!)
      Slider.prvBarBkgd = Viewport.new('VectorRectangle', table.merge({
         x = '0', y = 0, width = '100%', height = '100%',
      }, Slider.prvTheme.slider.bkgd))
   end,
   slider = function(Slider:table!, Viewport:obj!)
      GAP <const> = Slider.prvTheme.slider.bkgd.strokeWidth

      Slider.button = Viewport.new('VectorRectangle', table.merge({
         x = GAP, y = GAP, width = Viewport.width-(GAP*2), height = Viewport.height-(GAP*2)
      }, Slider.prvTheme.slider.fore))

      Viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Viewport, Event)
         if Event is FM_LOST_FOCUS then
            gui.applyStyle(Slider.button, Slider.prvTheme.slider.fore)
            Slider.events?.lostFocus(Slider)
            Slider.hasFocus = false
         else
            Slider.hasFocus = true
            if Slider.disabled then
               gui.applyStyle(Slider.button, Slider.prvTheme.slider.fore)
            else
               gui.applyStyle(Slider.button, Slider.prvTheme.slider.foreFocus)
               Slider.events?.focus(Slider)
            end
         end

         Viewport.acDraw()
      end)

      Viewport.mtSubscribeInput(JTYPE_CROSSING, function(Viewport, Msg)
         repeat
            if Msg.type is JET_CROSSED_IN then
               gui.applyStyle(Slider.button, Slider.prvTheme.slider.foreHighlight)
            elseif Msg.type is JET_CROSSED_OUT then
               gui.applyStyle(Slider.button, Slider.hasFocus ? Slider.prvTheme.slider.foreFocus : Slider.prvTheme.slider.fore)
            end
            Msg = Msg.next
         until not Msg

         Viewport.acDraw()
      end)
   end
}
