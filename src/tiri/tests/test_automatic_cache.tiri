-- Whole-script automatic cache behaviour that must hold across independent process states.

include 'core'

local glRoot
local glCacheFolder
local glXdgCache
local glRestoreXdg = false
local glSerial = 0

@BeforeAll function setup()
   local err, temp = mSys.ResolvePath('temp:', 0)
   check err
   glRoot = temp .. f'/automatic_cache.tests_{processing.task().id}_{mSys.PreciseTime()}/'
   local folder <close> = obj.new('file', { path=glRoot, flags=FL_NEW|FL_FOLDER })

   -- Linux prefers $XDG_CACHE_HOME/tiri/ over temp:.  Children inherit an XDG_CACHE_HOME that points into glRoot so
   -- that the user's real cache is never touched.

   if mSys.GetSystemState().platform is 'Linux' then
      local cache <close> = obj.new('file', { path=glRoot .. '.cache/', flags=FL_NEW|FL_FOLDER })
      _, glXdgCache = processing.task().mtGetEnv('XDG_CACHE_HOME')
      check processing.task().mtSetEnv('XDG_CACHE_HOME', glRoot .. '.cache')
      glRestoreXdg = true
      glCacheFolder = glRoot .. '.cache/tiri/'
   else
      glCacheFolder = glRoot .. 'tiri/cache/'
   end
end

@AfterAll function cleanup()
   if glRestoreXdg then processing.task().mtSetEnv('XDG_CACHE_HOME', glXdgCache ?? '') end
   if glRoot then check mSys.DeleteFile(glRoot) end
end

function path(Suffix:str):str
   glSerial++
   return glRoot .. tostring(glSerial) .. Suffix
end

function write_file(Path:str, Content:str)
   local file <close> = obj.new('file', { path=Path, flags=FL_NEW|FL_WRITE })
   if #Content > 0 then check file.acWrite(Content) end
end

function date_file(Path:str, Day:num)
   local file <close> = obj.new('file', { path=Path, flags=FL_READ|FL_WRITE })
   check file.mtSetDate(2025, 2, Day, 12, 0, 0, FDT_MODIFIED)
end

function child(Parameters:array<str>):<num, str>
   local output = ''
   local executable = processing.task().processPath .. 'origo'
   if mSys.GetSystemState().platform is 'Windows' then executable ..= '.exe' end
   local task <close> = obj.new('task', {
      location=executable, flags=TSF_WAIT, timeout=20,
      outputCallback=function(Task, Buffer) output ..= Buffer.getString() end,
      errorCallback=function(Task, Buffer) output ..= Buffer.getString() end
   })
   for parameter in values(Parameters) do check task.mtAddArgument(parameter) end
   check task.acActivate()
   return task.returnCode, output
end

function run(Runner:str, Source:str, Mode:str, Cache:str, Jit:str):<num, str>
   local arguments = array<str> {
      Runner, 'source=' .. Source, 'mode=' .. Mode, 'cache=' .. Cache, '--log-trace', '--gfx-driver=headless',
      '--set-volume', 'temp=' .. glRoot
   }
   if Jit != '' then
      arguments.push('--jit-options')
      arguments.push(Jit)
   end
   return child(arguments)
end

function assert_run(Output:str, Value:num)
   assert(Output.count('C05_CACHE_RUN:' .. tostring(Value) .. ':1') is 2,
      'Each fresh Script must activate twice while each imported body initialises once: ' .. Output)
end

function package_import(Packages:str, Statement:str):<num, str>
   return child(array<str> {
      '--statement', Statement, '--log-trace', '--gfx-driver=headless',
      '--set-volume', 'packages=' .. Packages, '--set-volume', 'temp=' .. glRoot
   })
end

function assert_valid_cache_graph(Output:str)
   assert(Output.find('Invalid module dependency descriptor') is nil, Output)
   assert(Output.find('Cannot load malformed bytecode') is nil, Output)
   assert(Output.find('conflicts with the active registration') is nil, Output)
end

function fixtures():<str, str, str>
   local stem = path('.unicode-ā.main')
   local source = stem .. '.tiri'
   local child_path = glRoot .. 'c05_child.tiri'
   local nested_path = glRoot .. 'c05_nested.tiri'
   local empty_path = glRoot .. 'c05_empty.tiri'
   local runner = path('_runner.tiri')

   write_file(nested_path, 'global function c05_nested_value():num return 42 end')
   write_file(child_path, [[
      import './c05_nested'
      namespace c05_fixture { }
      c05_fixture.value = c05_nested_value
      glC05ImportRuns++
   ]])
   write_file(empty_path, '')
   write_file(source, [[
      global glC05ImportRuns = 0
      import './c05_child' as cached
      import './c05_child' as cached
      import './c05_empty'
      assert(cached.value() > 0)
      print('C05_CACHE_RUN:' .. tostring(cached.value()) .. ':' .. tostring(glC05ImportRuns))
   ]])
   write_file(runner, [[
      local source = arg('source')
      local mode = arg('mode')
      local cache = arg('cache')
      local script:obj
      if mode is 'direct' then
         script = obj.new('tiri', { path=cache })
      elseif mode is 'automatic' then
         script = obj.new('tiri', { path=source, flags=SCF_AUTO_CACHE })
      elseif mode is 'explicit_auto' then
         script = obj.new('tiri', { path=source, cacheFile=cache, flags=SCF_AUTO_CACHE })
      elseif mode is 'explicit' then
         script = obj.new('tiri', { path=source, cacheFile=cache })
      else
         script = obj.new('tiri', { path=source })
      end
      defer script = nil end
      check script.acQuery()
      for i in {0 to 2} do
         check script.acActivate()
         assert(script.error is ERR_Okay, script.errorMessage)
      end
   ]])
   return source, nested_path, runner
end

----------------------------------------------------------------------------------------------------------------------
-- A cached package must preserve native dependencies declared by relative helpers, every helper source needed by a
-- dependent cache entry, and declared namespaces when the same transitive dependency is loaded through two branches.
-- Entry and helper both use Core: PreciseTime overlaps, while each file also requires a different native function.

@Test function CachedRelativeImportMetadataRemainsComplete()
   local packages = glRoot .. 'cache-graph-packages/'
   local package_root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   local names = array<str> { 'cache-dependency', 'cache-a', 'cache-b', 'cache-top' }
   for name in values(names) do
      local folder <close> = obj.new('file', { path=packages .. name .. '/', flags=FL_NEW|FL_FOLDER })
      local version <close> = obj.new('file', { path=packages .. name .. '/1/', flags=FL_NEW|FL_FOLDER })
   end

   write_file(packages .. 'index.cfg', '[cache-dependency]\n1 = cache-dependency/1/main.tiri\n' ..
      '[cache-a]\n1 = cache-a/1/main.tiri\n[cache-b]\n1 = cache-b/1/main.tiri\n' ..
      '[cache-top]\n1 = cache-top/1/main.tiri\n')
   write_file(packages .. 'cache-dependency/1/helper.tiri', [[
      global function cache_dependency_helper():num
         return mSys.PreciseTime() > 0 and mSys.GetSystemState().platform != '' ? 17 : 0
      end
   ]])
   write_file(packages .. 'cache-dependency/1/main.tiri', [[
      @Package(name="cache-dependency", version="1")
      import './helper'
      namespace cache_dependency { }
      assert(mSys.PreciseTime() > 0)
      local err, resolved = mSys.ResolvePath('temp:', 0)
      check err
      assert(resolved != '')
      cache_dependency.value = cache_dependency_helper()
   ]])
   write_file(packages .. 'cache-a/1/main.tiri', [[
      @Package(name="cache-a", version="1")
      import 'cache-dependency'
      namespace cache_a { }
      cache_a.value = cache_dependency.value + 1
   ]])
   write_file(packages .. 'cache-b/1/main.tiri', [[
      @Package(name="cache-b", version="1")
      import 'cache-dependency'
      namespace cache_b { }
      cache_b.value = cache_dependency.value + 2
   ]])
   write_file(packages .. 'cache-top/1/main.tiri', [[
      @Package(name="cache-top", version="1")
      import 'cache-a', 'cache-b'
      namespace cache_top { }
      cache_top.value = cache_a.value + cache_b.value
   ]])

   local statements = array<str> {
      "import 'cache-dependency'; print('CACHE_GRAPH_VALUE:' .. cache_dependency.value)",
      "import 'cache-dependency'; print('CACHE_GRAPH_VALUE:' .. cache_dependency.value)",
      "import 'cache-a'; print('CACHE_GRAPH_VALUE:' .. cache_a.value)",
      "import 'cache-a'; print('CACHE_GRAPH_VALUE:' .. cache_a.value)",
      "import 'cache-b'; print('CACHE_GRAPH_VALUE:' .. cache_b.value)",
      "import 'cache-b'; print('CACHE_GRAPH_VALUE:' .. cache_b.value)",
      "import 'cache-top'; print('CACHE_GRAPH_VALUE:' .. cache_top.value)",
      "import 'cache-top'; print('CACHE_GRAPH_VALUE:' .. cache_top.value)"
   }
   local expected = array<int> { 17, 17, 18, 18, 19, 19, 37, 37 }

   for index, statement in statements do
      local code, output = package_import(packages, statement)
      assert(code is 0 and output.find('CACHE_GRAPH_VALUE:' .. tostring(expected[index])) != nil, output)
      assert_valid_cache_graph(output)
      if index is 1 or index is 3 or index is 5 or index is 7 then
         assert(output.find('source-compilations=0 publications=0') != nil,
            'A warm package graph must load entirely from cache: ' .. output)
      end
   end
end

----------------------------------------------------------------------------------------------------------------------
-- A runtime module lexer error unwinds through lua_load's protected boundary.  Later compilations must not retain
-- the failed module's capture, including on Windows where SEH skips parser-local destructors.

@Test function RuntimeImportRecoversAfterLexicalError()
   local packages = glRoot .. 'failed-import-packages/'
   local package_root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   for name in values(array<str> { 'broken-module', 'recovery-module' }) do
      local folder <close> = obj.new('file', { path=packages .. name .. '/', flags=FL_NEW|FL_FOLDER })
      local version <close> = obj.new('file', { path=packages .. name .. '/1/', flags=FL_NEW|FL_FOLDER })
   end
   write_file(packages .. 'index.cfg', '[broken-module]\n1 = broken-module/1/main.tiri\n' ..
      '[recovery-module]\n1 = recovery-module/1/main.tiri\n')
   write_file(packages .. 'broken-module/1/main.tiri',
      '@Package(name="broken-module", version="1")\n' .. "local value = 'unterminated")
   write_file(packages .. 'recovery-module/1/main.tiri', [[
      @Package(name="recovery-module", version="1")
      namespace recovery_module { value=42 }
   ]])

   local code, output = package_import(packages, [[
      local caught = false
      try
         exec("import 'broken-module'")
      except e
         assert(e.message.find('Unfinished string') != nil, e.message)
         caught = true
      end
      assert(caught, 'The malformed package must raise a lexer error')
      for pass in {0 to 2} do
         exec("@if(platform='definitely-not-a-platform')\nlocal skipped = true\n@end")
      end
      exec("import 'recovery-module'; assert(recovery_module.value is 42)")
      print('RUNTIME_IMPORT_RECOVERED')
   ]])
   assert(code is 0 and output.find('RUNTIME_IMPORT_RECOVERED') != nil, output)
   assert_valid_cache_graph(output)
end

----------------------------------------------------------------------------------------------------------------------
-- A statement root has no whole-script manifest, yet the package modules it compiles must still record their relative
-- helpers in their own cache identities.  Changing a helper of a transitively imported package must not reuse stale
-- entries.

@Test function StatementRootModulesTrackRelativeHelpers()
   local packages = glRoot .. 'statement-helper-packages/'
   local package_root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   for name in values(array<str> { 'gen-leaf', 'gen-top' }) do
      local folder <close> = obj.new('file', { path=packages .. name .. '/', flags=FL_NEW|FL_FOLDER })
      local version <close> = obj.new('file', { path=packages .. name .. '/1/', flags=FL_NEW|FL_FOLDER })
   end

   local helper = packages .. 'gen-leaf/1/helper.tiri'
   write_file(packages .. 'index.cfg', '[gen-leaf]\n1 = gen-leaf/1/main.tiri\n[gen-top]\n1 = gen-top/1/main.tiri\n')
   write_file(helper, 'global function gen_leaf_helper():num return 1 end')
   date_file(helper, 3)
   write_file(packages .. 'gen-leaf/1/main.tiri', [[
      @Package(name="gen-leaf", version="1")
      import './helper'
      namespace gen_leaf { }
      gen_leaf.value = gen_leaf_helper()
   ]])
   write_file(packages .. 'gen-top/1/main.tiri', [[
      @Package(name="gen-top", version="1")
      import 'gen-leaf'
      namespace gen_top { }
      gen_top.value = gen_leaf.value + 100
   ]])

   local statement = "import 'gen-top'; print('STATEMENT_HELPER_VALUE:' .. gen_top.value)"
   for pass in {0 to 2} do
      local code, output = package_import(packages, statement)
      assert(code is 0 and output.find('STATEMENT_HELPER_VALUE:101') != nil, output)
      if pass is 1 then
         assert(output.find('Imported-module validation: hits=2 misses=0') != nil,
            'The unchanged package graph must load from cache: ' .. output)
      end
   end

   write_file(helper, 'global function gen_leaf_helper():num return 2 end')
   date_file(helper, 4)

   local code, output = package_import(packages, statement)
   assert(code is 0 and output.find('STATEMENT_HELPER_VALUE:102') != nil,
      'A changed relative helper must invalidate the cached package: ' .. output)
   assert(output.find('misses=0') is nil, 'The changed package must recompile from source: ' .. output)
   assert_valid_cache_graph(output)

   code, output = package_import(packages, statement)
   assert(code is 0 and output.find('STATEMENT_HELPER_VALUE:102') != nil, output)
   assert(output.find('Imported-module validation: hits=2 misses=0') != nil,
      'The republished package graph must load from cache: ' .. output)
end

----------------------------------------------------------------------------------------------------------------------
-- A cached component that joins its owning package's namespace must reuse the namespace declaration's local.

@Test function SplitPackageComponentsReuseOwningNamespace()
   local packages = glRoot .. 'split-packages/'
   local root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   local folder <close> = obj.new('file', { path=packages .. 'cache-split/', flags=FL_NEW|FL_FOLDER })
   write_file(packages .. 'index.cfg', '[cache-split]\n1 = cache-split/main.tiri\n' ..
      '[cache-split/component]\n1 = cache-split/component.tiri\n')
   write_file(packages .. 'cache-split/main.tiri', [[
      @Package(name="cache-split", version="1")
      namespace cache_split { value = 17 }
      import 'cache-split/component'
      assert(cache_split is _LIB.cache_split)
      assert(cache_split.value is 17 and cache_split.component is 25)
   ]])
   write_file(packages .. 'cache-split/component.tiri', [[
      @Package(name="cache-split/component", version="1")
      namespace cache_split
      cache_split.component = 25
   ]])

   -- Prime only the component so that the owning package must compile around a cached namespace join.
   local code, output = package_import(packages,
      "namespace cache_split { }; import 'cache-split/component'; assert(cache_split.component is 25)")
   assert(code is 0, output)

   for pass in {0 to 2} do
      code, output = package_import(packages,
         "import 'cache-split'; print('SPLIT_CACHE_VALUE:' .. (cache_split.value + cache_split.component))")
      assert(code is 0 and output.find('SPLIT_CACHE_VALUE:42') != nil, output)
      assert_valid_cache_graph(output)
      if pass is 0 then
         assert(output.find('Imported-module validation: hits=1 misses=1') != nil,
            'The owning source package must reuse its cached component: ' .. output)
      else
         assert(output.find('source-compilations=0 publications=0') != nil,
            'The warm split package must load entirely from cache: ' .. output)
      end
   end
end

----------------------------------------------------------------------------------------------------------------------
-- Package declarations discovered during parsing must not change the cache location used by subsequent imports.

@Test function DeclaredPackageImportsReusePublishedCache()
   local packages = glRoot .. 'packages/'
   local root_folder <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   local package_folder <close> = obj.new('file', { path=packages .. 'declared-package/', flags=FL_NEW|FL_FOLDER })
   local arguments = array<str> {
      '--statement', "import 'declared-package'; print('PACKAGE_CACHE_VALUE:' .. declared_package.value)",
      '--log-trace', '--gfx-driver=headless', '--set-volume', 'packages=' .. packages,
      '--set-volume', 'temp=' .. glRoot
   }

   for version in {1 into 2} do
      local version_path = packages .. 'declared-package/' .. tostring(version) .. '/'
      local version_folder <close> = obj.new('file', { path=version_path, flags=FL_NEW|FL_FOLDER })
      write_file(packages .. 'index.cfg', '[declared-package]\n' .. tostring(version) ..
         ' = declared-package/' .. tostring(version) .. '/main.tiri\n')
      write_file(version_path .. 'main.tiri',
         '@Package(name="declared-package", version="' .. tostring(version) .. '")\n' ..
         'namespace declared_package { }\ndeclared_package.value = ' .. tostring(version))

      local code, output = child(arguments)
      assert(code is 0 and output.find('PACKAGE_CACHE_VALUE:' .. tostring(version)) != nil, output)
      assert(output.find('Imported-module validation: hits=0 misses=1') != nil and
         output.find('source-compilations=1 publications=1') != nil,
         'A new package source must compile and publish its cache: ' .. output)

      code, output = child(arguments)
      assert(code is 0 and output.find('PACKAGE_CACHE_VALUE:' .. tostring(version)) != nil, output)
      assert(output.find('Imported-module validation: hits=1 misses=0') != nil and
         output.find('source-compilations=0 publications=0') != nil,
         'A fresh process must reuse the declared package cache without recompilation: ' .. output)
   end
end

----------------------------------------------------------------------------------------------------------------------
-- A cold producer and warm consumers use independent Lua states.  JIT policy does not affect cache identity, and
-- omitting AUTO_CACHE must ignore a pre-existing automatic entry.

@Test function FreshAutomaticProducerAndConsumers()
   local source, _, runner = fixtures()
   local code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0 and output.find('Cache hit') is nil, output)
   assert_run(output, 42)

   code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0 and output.find('Cache hit') != nil, output)
   assert_run(output, 42)

   code, output = run(runner, source, 'automatic', '', 'off')
   assert(code is 0 and output.find('Cache hit') != nil, output)
   assert_run(output, 42)

   code, output = run(runner, source, 'disabled', '', '')
   assert(code is 0 and output.find('Cache hit') is nil, output)
   assert_run(output, 42)

   check mSys.DeleteFile(glCacheFolder)
   code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0 and output.find('Cache hit') is nil, output)
   assert_run(output, 42)
   code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0 and output.find('Cache hit') != nil, output)
   assert_run(output, 42)
end

----------------------------------------------------------------------------------------------------------------------
-- An explicit destination works independently of AUTO_CACHE and remains authoritative when the flag is also set.

@Test function ExplicitDestinationPrecedenceAcrossProcesses()
   local source, _, runner = fixtures()
   local cache = path('_explicit.tbc')
   local code, output = run(runner, source, 'explicit', cache, '')
   assert(code is 0 and output.find('Cache hit') is nil, output)
   assert_run(output, 42)

   code, output = run(runner, source, 'explicit_auto', cache, '')
   assert(code is 0 and output.find('Cache hit') != nil, output)
   assert_run(output, 42)
end

----------------------------------------------------------------------------------------------------------------------
-- Dependency content, rather than size or modification time, invalidates a warm entry in a fresh consumer.

@Test function SameSizeSameDateDependencyInvalidation()
   local source, nested, runner = fixtures()
   date_file(nested, 1)
   local code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0, output)
   assert_run(output, 42)
   code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0 and output.find('Cache hit') != nil, output)

   write_file(nested, 'global function c05_nested_value():num return 43 end')
   date_file(nested, 1)
   code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0 and output.find('Cache hit') is nil, output)
   assert_run(output, 43)

   code, output = run(runner, source, 'automatic', '', '')
   assert(code is 0 and output.find('Cache hit') != nil, output)
   assert_run(output, 43)
end

----------------------------------------------------------------------------------------------------------------------
-- Competing fresh producers must publish complete self-describing entries.  A later reader must observe a valid
-- generation rather than a partial or mixed payload.

@Disabled; @Test function ConcurrentProducersPublishCompleteEntry()
   local source, nested, runner = fixtures()
   local cache = path('_concurrent.tbc')
   local code, output = run(runner, source, 'explicit', cache, '')
   assert(code is 0, output)
   assert_run(output, 42)
   write_file(nested, 'global function c05_nested_value():num return 43 end')

   local executable = processing.task().processPath .. 'origo'
   if mSys.GetSystemState().platform is 'Windows' then executable ..= '.exe' end
   local tasks = array<obj> {}
   local outputs = array<str> {}
   local modes = array<str> {}
   local completed = 0
   defer
      for task in values(tasks) do task.free() end
   end

   for index in {0 to 8} do
      outputs.push('')
      local mode = index % 2 is 0 ? 'explicit_auto' : 'direct'
      modes.push(mode)
      local task = obj.new('task', {
         location=executable, timeout=20,
         outputCallback=function(Task, Buffer) outputs[index] ..= Buffer.getString() end,
         errorCallback=function(Task, Buffer) outputs[index] ..= Buffer.getString() end,
         exitCallback=function(Task) completed++ processing.signal() end
      })
      check task.mtAddArgument(runner)
      check task.mtAddArgument('source=' .. source)
      check task.mtAddArgument('mode=' .. mode)
      check task.mtAddArgument('cache=' .. cache)
      check task.mtAddArgument('--log-warning')
      tasks.push(task)
      check task.acActivate()
   end

   local deadline = mSys.PreciseTime() + 3000000
   while completed < #tasks and mSys.PreciseTime() < deadline do
      check processing.sleep(0.1)
   end
   assert(completed is #tasks, 'Concurrent cache producers did not finish within 30 seconds')
   for index, task in ipairs(tasks) do
      assert(task.returnCode is 0, outputs[index])
      if modes[index] is 'direct' and outputs[index].find('C05_CACHE_RUN:42:1') != nil then
         assert_run(outputs[index], 42)
      else
         assert_run(outputs[index], 43)
      end
   end

   code, output = run(runner, source, 'explicit', cache, '')
   assert(code is 0 and output.find('Cache hit') != nil, output)
   assert_run(output, 43)
end

----------------------------------------------------------------------------------------------------------------------
-- Module-cache fragments.  Each cache entry stores only its own initialiser and references separately cached
-- dependencies, so these helpers locate entries by the package paths recorded in their uncompressed identities.

function read_bytes(Path:str):str
   local file <close> = io.open(Path, 'r')
   return file.read('*a')
end

function fragment_entries(Packages:array<str>):table
   local entries = {}
   local folder <close> = obj.new('file', { path=glCacheFolder, flags=FL_FOLDER|FL_READ })
   local err, file = folder.mtNext()
   while err is ERR_Okay do
      local name = file.path
      if name.find('import-') != nil and name.endsWith('.tbc') then
         local content = read_bytes(name)
         -- Importers record their dependencies' paths, so the owning module is the last matching package in
         -- dependency-first order.
         local owner
         for package in values(Packages) do
            if content.find('/' .. package .. '/') != nil then owner = package end
         end
         if owner then entries[owner] = { path=name, size=file.size } end
      end
      err, file = folder.mtNext()
   end
   return entries
end

function clear_fragment_entries(Packages:array<str>)
   local entries = fragment_entries(Packages)
   while table.size(entries) > 0 do
      for _, entry in entries do check mSys.DeleteFile(entry.path) end
      entries = fragment_entries(Packages)
   end
end

function write_package(Packages:str, Name:str, Source:str)
   local folder <close> = obj.new('file', { path=Packages .. Name .. '/', flags=FL_NEW|FL_FOLDER })
   local version <close> = obj.new('file', { path=Packages .. Name .. '/1/', flags=FL_NEW|FL_FOLDER })
   write_file(Packages .. Name .. '/1/main.tiri', Source)
end

-- The shared leaf owns a large private body behind a small interface, so its code size can grow without changing
-- what its importers compile against.

function fragment_leaf_source(Value:num, Helpers:num):str
   local source = '@Package(name="frag-leaf", version="1")\nnamespace frag_leaf { }\nglFragmentLeafRuns++\n'
   for index in {0 to Helpers} do
      source ..= f'local function helper_{index}(Value:num):num\n'
      source ..= f'   local text = "fragment leaf helper {index} " .. tostring(Value)\n'
      source ..= f'   return #text + Value * {index} - {index} * Value\nend\n'
   end
   source ..= f'local total = 0\n'
   for index in {0 to Helpers} do source ..= f'total += helper_{index}(1)\n' end
   source ..= f'frag_leaf.value = {Value}\nfrag_leaf.total = total\n'
   return source
end

function write_fragment_graph(Packages:str, LeafValue:num, Helpers:num)
   write_file(Packages .. 'index.cfg', '[frag-leaf]\n1 = frag-leaf/1/main.tiri\n' ..
      '[frag-left]\n1 = frag-left/1/main.tiri\n[frag-right]\n1 = frag-right/1/main.tiri\n' ..
      '[frag-top]\n1 = frag-top/1/main.tiri\n')
   write_package(Packages, 'frag-leaf', fragment_leaf_source(LeafValue, Helpers))
   write_package(Packages, 'frag-left', [[
      @Package(name="frag-left", version="1")
      import 'frag-leaf'
      namespace frag_left { }
      frag_left.value = frag_leaf.value + 1
   ]])
   write_package(Packages, 'frag-right', [[
      @Package(name="frag-right", version="1")
      import 'frag-leaf'
      namespace frag_right { }
      frag_right.value = frag_leaf.value + 2
   ]])
   write_package(Packages, 'frag-top', [[
      @Package(name="frag-top", version="1")
      import 'frag-left', 'frag-right'
      namespace frag_top { }
      frag_top.value = frag_left.value + frag_right.value
   ]])
end

function run_fragment_graph(Packages:str, Expected:num):str
   local code, output = package_import(Packages, "global glFragmentLeafRuns = 0; import 'frag-top'; " ..
      "print('FRAGMENT_VALUE:' .. frag_top.value .. ':' .. glFragmentLeafRuns)")
   assert(code is 0 and output.find('FRAGMENT_VALUE:' .. tostring(Expected) .. ':1') != nil,
      'The diamond graph must produce its value and initialise the shared leaf once: ' .. output)
   assert_valid_cache_graph(output)
   return output
end

----------------------------------------------------------------------------------------------------------------------
-- A diamond with a large shared leaf persists the leaf's code once.  Warm, partially populated and corrupt caches
-- link the same graph, initialise the leaf once and decode each module exactly once.

@Test function FragmentCacheStoresSharedLeafOnce()
   local packages = glRoot .. 'fragment-packages/'
   local root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   local names = array<str> { 'frag-leaf', 'frag-left', 'frag-right', 'frag-top' }
   write_fragment_graph(packages, 10, 20)

   local output = run_fragment_graph(packages, 23)
   assert(output.find('hits=0 misses=4') != nil and output.find('source-compilations=4 publications=4') != nil,
      'A cold graph must compile and publish each module once: ' .. output)

   output = run_fragment_graph(packages, 23)
   assert(output.find('hits=4 misses=0') != nil and output.find('source-compilations=0 publications=0') != nil and
      output.find('destination-loads=4 ') != nil,
      'A warm graph must link every module from its own cache entry exactly once: ' .. output)

   local small = fragment_entries(names)
   for name in values(names) do assert(small[name], 'Missing cache entry for ' .. name) end

   -- Remove one parent: the remaining entries are reused and only the missing branch and its importer rebuild.
   check mSys.DeleteFile(small['frag-left'].path)
   output = run_fragment_graph(packages, 23)
   assert(output.find('hits=2 misses=2') != nil and output.find('source-compilations=2 publications=2') != nil,
      'A partially populated cache must reuse valid dependencies: ' .. output)

   -- Corrupt the shared leaf: every importer must reject its fragment rather than link stale or missing code.
   write_file(fragment_entries(names)['frag-leaf'].path, 'TIRIMOD1-corrupt')
   output = run_fragment_graph(packages, 23)
   assert(output.find('hits=0 misses=4') != nil,
      'A corrupt dependency entry must invalidate every importer: ' .. output)

   -- Change only the leaf implementation.  The interface is unchanged, but the new compiled identity must still
   -- invalidate the importers.
   write_package(packages, 'frag-leaf', fragment_leaf_source(11, 20))
   output = run_fragment_graph(packages, 25)
   assert(output.find('hits=0 misses=4') != nil,
      'A changed dependency implementation must invalidate its importers: ' .. output)

   -- Grow the leaf's code eightfold.  Parent entries reference the leaf and must not grow with it.  Superseded
   -- entries remain under their old lookup keys, so measure each generation from an otherwise empty cache.
   local function measure(Helpers:num):table
      clear_fragment_entries(names)
      write_package(packages, 'frag-leaf', fragment_leaf_source(11, Helpers))
      run_fragment_graph(packages, 25)
      local warm = run_fragment_graph(packages, 25)
      assert(warm.find('hits=4 misses=0') != nil, 'The rebuilt graph must be warm: ' .. warm)
      return fragment_entries(names)
   end
   small = measure(20)
   local large = measure(160)
   assert(large['frag-leaf'].size > small['frag-leaf'].size + 4096,
      f"The leaf entry must grow with its code: {small['frag-leaf'].size} -> {large['frag-leaf'].size}")
   for name in values(array<str> { 'frag-left', 'frag-right', 'frag-top' }) do
      assert(math.abs(large[name].size - small[name].size) < 256,
         f'{name} must not embed the leaf body: {small[name].size} -> {large[name].size}')
      assert(large[name].size * 2 < large['frag-leaf'].size,
         f"{name} must be smaller than the shared leaf: {large[name].size} vs {large['frag-leaf'].size}")
   end
end

----------------------------------------------------------------------------------------------------------------------
-- A module imported through a relative helper is activated by the helper's owner, so it is part of the owner's
-- identity.  Changing that module must rebuild the owner rather than reuse stale code.

@Test function RelativeHelperModuleDependencyInvalidatesOwner()
   local packages = glRoot .. 'helper-packages/'
   local root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   write_file(packages .. 'index.cfg', '[helper-leaf]\n1 = helper-leaf/1/main.tiri\n' ..
      '[helper-owner]\n1 = helper-owner/1/main.tiri\n')
   write_package(packages, 'helper-leaf',
      '@Package(name="helper-leaf", version="1")\nnamespace helper_leaf { }\nhelper_leaf.value = 1\n')
   write_package(packages, 'helper-owner', [[
      @Package(name="helper-owner", version="1")
      import './helper'
      namespace helper_owner { }
      helper_owner.value = helper_value()
   ]])
   write_file(packages .. 'helper-owner/1/helper.tiri', [[
      import 'helper-leaf'
      global function helper_value():num return helper_leaf.value end
   ]])

   local statement = "import 'helper-owner'; print('HELPER_VALUE:' .. helper_owner.value)"
   for pass in {0 to 2} do
      local code, output = package_import(packages, statement)
      assert(code is 0 and output.find('HELPER_VALUE:1') != nil, output)
      if pass is 1 then
         assert(output.find('hits=2 misses=0') != nil, 'The helper dependency must be validated: ' .. output)
      end
   end

   write_package(packages, 'helper-leaf',
      '@Package(name="helper-leaf", version="1")\nnamespace helper_leaf { }\nhelper_leaf.value = 2\n')
   local code, output = package_import(packages, statement)
   assert(code is 0 and output.find('HELPER_VALUE:2') != nil and output.find('hits=0 misses=2') != nil,
      'A changed module imported through a relative helper must rebuild its owner: ' .. output)
end

----------------------------------------------------------------------------------------------------------------------
-- Saved bytecode is self-contained whether its imports were compiled cold or linked from fragments.  It must run and
-- re-save after the module cache entries are removed.

@Test function ExportedBytecodeIsIndependentOfFragments()
   local packages = glRoot .. 'export-packages/'
   local root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   write_fragment_graph(packages, 30, 10)
   local source = glRoot .. 'export_main.tiri'
   write_file(source, "global glFragmentLeafRuns = 0\nimport 'frag-top'\n" ..
      "print('EXPORT_VALUE:' .. frag_top.value .. ':' .. glFragmentLeafRuns)\n")
   local saver = glRoot .. 'export_saver.tiri'
   write_file(saver, [[
      local script <close> = obj.new('tiri', { path=arg('source') })
      local file <close> = obj.new('file', { path=arg('output'), flags=FL_NEW|FL_WRITE })
      check script.acSaveToObject(file)
   ]])

   local function save(Output:str, Source:str):str
      local code, output = child(array<str> { saver, 'source=' .. Source, 'output=' .. Output, '--log-trace',
         '--gfx-driver=headless', '--set-volume', 'packages=' .. packages, '--set-volume', 'temp=' .. glRoot })
      assert(code is 0, output)
      return output
   end

   local function execute(Path:str)
      local code, output = child(array<str> { Path, '--log-warning', '--gfx-driver=headless',
         '--set-volume', 'packages=' .. packages, '--set-volume', 'temp=' .. glRoot })
      assert(code is 0 and output.find('EXPORT_VALUE:63:1') != nil, 'Exported bytecode failed: ' .. output)
   end

   local names = array<str> { 'frag-leaf', 'frag-left', 'frag-right', 'frag-top' }
   local cold = glRoot .. 'export_cold.tbc'
   local warm = glRoot .. 'export_warm.tbc'
   save(cold, source)
   local output = save(warm, source)
   assert(output.find('source-compilations=0') != nil, 'The second export must link cached fragments: ' .. output)

   clear_fragment_entries(names)
   execute(cold)
   execute(warm)

   local resaved = glRoot .. 'export_resaved.tbc'
   save(resaved, warm)
   execute(resaved)
end

----------------------------------------------------------------------------------------------------------------------
-- A warm-linked dependency keeps its structure declarations and its own source lines in runtime diagnostics.

@Test function LinkedDependencyPreservesStructuresAndDiagnostics()
   local packages = glRoot .. 'diagnostic-packages/'
   local root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   write_file(packages .. 'index.cfg', '[diag-leaf]\n1 = diag-leaf/1/leaf.tiri\n[diag-mid]\n1 = diag-mid/1/mid.tiri\n')
   for name in values(array<str> { 'diag-leaf', 'diag-mid' }) do
      local folder <close> = obj.new('file', { path=packages .. name .. '/', flags=FL_NEW|FL_FOLDER })
      local version <close> = obj.new('file', { path=packages .. name .. '/1/', flags=FL_NEW|FL_FOLDER })
   end
   write_file(packages .. 'diag-leaf/1/leaf.tiri', [[@Package(name="diag-leaf", version="1")
namespace diag_leaf { }
struct DiagPoint
   X: double
   Y: double
end
function diag_leaf.fail(Value:num)
   raise 'DIAG_LEAF_FAILURE ' .. tostring(Value)
end
]])
   write_file(packages .. 'diag-mid/1/mid.tiri', [[@Package(name="diag-mid", version="1")
import 'diag-leaf'
namespace diag_mid { }
function diag_mid.point():struct
   return struct<DiagPoint> { X=3, Y=4 }
end
function diag_mid.call()
   diag_leaf.fail(7)
end
]])
   local script = path('_diagnostics.tiri')
   write_file(script, [[
      import 'diag-mid'
      local point = diag_mid.point()
      print('DIAG_POINT:' .. (point.X + point.Y))
      try<trace>
         diag_mid.call()
      except e
         print('DIAG_ERROR:' .. e.message .. ' @ ' .. tostring(e.line))
         print('DIAG_TRACE:' .. tostring(e.stackTrace ?? e.trace))
      end
   ]])

   for pass in {0 to 2} do
      local code, output = child(array<str> { script, '--log-trace', '--gfx-driver=headless',
         '--set-volume', 'packages=' .. packages, '--set-volume', 'temp=' .. glRoot })
      assert(code is 0 and output.find('DIAG_POINT:7') != nil and
         output.find('DIAG_ERROR:DIAG_LEAF_FAILURE 7 @ 8') != nil and output.find('leaf.tiri:8') != nil and
         output.find('mid.tiri:8') != nil, 'Dependency structures and diagnostics must be preserved: ' .. output)
      assert(output.find(pass is 0 ? 'hits=0 misses=2' : 'hits=2 misses=0') != nil, output)
   end
end

----------------------------------------------------------------------------------------------------------------------
-- Entries are published independently, so a reader can observe a parent from one generation beside a dependency
-- from another.  A relative helper changes the dependency's compiled identity without changing its lookup key; the
-- stale side of either mixture must be rejected rather than linked.

@Test function MixedGenerationEntriesAreNotLinked()
   local packages = glRoot .. 'generation-packages/'
   local root <close> = obj.new('file', { path=packages, flags=FL_NEW|FL_FOLDER })
   local names = array<str> { 'gen-leaf', 'gen-top' }
   write_file(packages .. 'index.cfg', '[gen-leaf]\n1 = gen-leaf/1/main.tiri\n[gen-top]\n1 = gen-top/1/main.tiri\n')
   write_package(packages, 'gen-leaf', [[
      @Package(name="gen-leaf", version="1")
      import './helper'
      namespace gen_leaf { }
      gen_leaf.value = gen_helper_value()
   ]])
   write_package(packages, 'gen-top', [[
      @Package(name="gen-top", version="1")
      import 'gen-leaf'
      namespace gen_top { }
      gen_top.value = gen_leaf.value * 10
   ]])

   -- A file root is required: path-less roots such as --statement do not capture relative-import observations.
   local script = path('_generation.tiri')
   write_file(script, "import 'gen-top'\nprint('GEN_VALUE:' .. gen_top.value)\n")
   local function run_root():<num, str>
      return child(array<str> { script, '--log-trace', '--gfx-driver=headless',
         '--set-volume', 'packages=' .. packages, '--set-volume', 'temp=' .. glRoot })
   end

   local function generation(Value:num):table
      write_file(packages .. 'gen-leaf/1/helper.tiri', f'global function gen_helper_value():num return {Value} end')
      local code, output = run_root()
      assert(code is 0 and output.find('GEN_VALUE:' .. tostring(Value * 10)) != nil, output)
      local entries = fragment_entries(names)
      return { leaf=read_bytes(entries['gen-leaf'].path), top=read_bytes(entries['gen-top'].path),
         leaf_path=entries['gen-leaf'].path, top_path=entries['gen-top'].path }
   end

   local first = generation(1)
   local second = generation(2)
   assert(first.leaf_path is second.leaf_path and first.top_path is second.top_path and
      first.leaf != second.leaf and first.top != second.top,
      'Both generations must publish different content under the same lookup keys')

   write_file(second.top_path, first.top)
   local code, output = run_root()
   assert(code is 0 and output.find('GEN_VALUE:20') != nil and output.find('hits=1 misses=1') != nil,
      'A stale parent must not link a newer dependency: ' .. output)

   write_file(second.leaf_path, first.leaf)
   code, output = run_root()
   assert(code is 0 and output.find('GEN_VALUE:20') != nil and output.find('hits=0 misses=2') != nil,
      'A stale dependency must invalidate its importer: ' .. output)

   code, output = run_root()
   assert(code is 0 and output.find('GEN_VALUE:20') != nil and output.find('hits=2 misses=0') != nil,
      'The republished generation must be warm: ' .. output)
end
