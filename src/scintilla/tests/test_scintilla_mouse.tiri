-- Tests for pointer input in the Scintilla class.  Pointer input is received by the Canvas, which reports positions in
-- the coordinate system of the Page.  Pointer events are injected as dcDeviceInput records through the SystemPointer,
-- and the scene must be drawn before the first event because input boundaries are recorded when the scene is drawn.
-- Selections are verified by deleting them with the keyboard and reading back the document.
--
-- The default font is Clean, which has 7 pixel wide glyphs and a 13 pixel line height.  The default LeftMargin of 4
-- means that text starts at x = 4.  The 120 pixel high View shows 9 whole lines.

   include 'scintilla', 'vector', 'display'

PAGE_WIDTH  = 300
PAGE_HEIGHT = 120
LINE_HEIGHT = 13
GLYPH_WIDTH = 7
TEXT_LEFT   = 4

DOCUMENT = 'alpha beta gamma\nsecond line here\nthird line\nfourth'

----------------------------------------------------------------------------------------------------------------------

function putDouble(Buffer:array<byte>!, Offset:num!, Value:num!)
   if Value is 0 then return end
   local sign = (Value < 0) ? 2147483648 : 0
   Value = math.abs(Value)
   local mantissa, exponent = math.frexp(Value)
   local fraction = ((mantissa * 2) - 1) * 1048576
   local high = sign + ((exponent + 1022) * 1048576) + math.floor(fraction)
   local low = (fraction - math.floor(fraction)) * 4294967296
   for i in {0 to 4} do
      Buffer[Offset + i] = math.floor(low / (256 ** i)) % 256
      Buffer[Offset + 4 + i] = math.floor(high / (256 ** i)) % 256
   end
end

-- Feed one dcDeviceInput record: { double Values[2]; int64 Timestamp; OBJECTID DeviceID; JTYPE Flags; JET Type }.
-- A zero timestamp is replaced with the current time by the pointer.

function feed(Type:num!, X:num!, Y:num!)
   local input = array<byte, 40>
   putDouble(input, 0, X)
   putDouble(input, 8, Y)
   input[32] = Type
   check obj.find('SystemPointer').acDataFeed(nil, DATA_DEVICE_INPUT, input)
   processing.sleep(0)
end

-- Broadcast a key event in the form of an evKey record: { int64 EventID; KQ Qualifiers; KEY Code; int Unicode }.
-- See test_scintilla_keyboard.tiri.

function sendKey(Code:num!, Qualifiers:num!)
   local qualifiers = Qualifiers
   if not (qualifiers has KQ_RELEASED) then qualifiers = qualifiers | KQ_PRESSED end
   local ev = array<int, 6>
   ev[0] = ('keypress').hash()
   ev[1] = (EVG_IO << 24) | (('keyboard').hash() & 0xffffff)
   ev[2] = qualifiers | KQ_NOT_PRINTABLE
   ev[3] = Code
   check mSys.BroadcastEvent(ev, 24)
   processing.sleep(0)
end

-- Hold or release a modifier key.  The editor records the modifier state from key events for use with pointer input.

function holdKey(Code:num!, Qualifier:num!)
   sendKey(Code, Qualifier)
end

function releaseKey(Code:num!)
   sendKey(Code, KQ_RELEASED)
end

function deleteSelection()
   sendKey(KEY_DELETE, 0)
end

-- Surface coordinates of a character cell, measured from the top-left of the View.  The pointer is placed one pixel
-- into the cell, which Scintilla resolves to the position before the character.

function cellX(Surface:obj!, Column:num!):num
   return Surface.absX + TEXT_LEFT + (Column * GLYPH_WIDTH) + 1
end

function cellY(Surface:obj!, Row:num!):num
   return Surface.absY + (Row * LINE_HEIGHT) + 6
end

function moveTo(Surface:obj!, Column:num!, Row:num!)
   feed(JET_ABS_XY, cellX(Surface, Column), cellY(Surface, Row))
end

function press()
   feed(JET_LMB, 1, 0)
end

function release()
   feed(JET_LMB, 0, 0)
end

function clickAt(Surface:obj!, Column:num!, Row:num!)
   moveTo(Surface, Column, Row)
   press()
   release()
end

function dragTo(Surface:obj!, FromColumn:num!, FromRow:num!, ToColumn:num!, ToRow:num!)
   moveTo(Surface, FromColumn, FromRow)
   press()
   moveTo(Surface, ToColumn, ToRow)
   release()
end

-- Scintilla ignores a click in the same millisecond as the previous one, which it treats as button bounce.  Clicks
-- that form a double or triple click are therefore spaced apart.

function multiClick(Surface:obj!, Column:num!, Row:num!, Count:num!)
   for i in {0 to Count} do
      if i > 0 then processing.sleep(0.02) end
      clickAt(Surface, Column, Row)
   end
end

-- Scintilla only combines clicks that are within 3 pixels of each other, so the clicks of a test are a cell apart
-- unless they are meant to be combined.  Repeated clicks at one position must wait for the double click interval.

function waitForClickInterval()
   processing.sleep(obj.find('SystemPointer').doubleClick + 0.05)
end

function show(Surface:obj!)
   Surface.acShow()
   Surface.acDraw()
   processing.sleep(0)
   Surface.acDraw()
   processing.sleep(0)
end

-- Create a surface with a scene that hosts a Scintilla object, and draw it so that input boundaries are recorded.
-- The surface is focused so that the editor receives modifier keys.  The editor is editable unless Options specifies
-- the flags.

function newEditor(Options:table, Text:str):<obj, obj, obj, obj>
   local surface = obj.new('Surface', { width=PAGE_WIDTH, height=PAGE_HEIGHT })
   local scene = surface.new('VectorScene', { surface=surface })
   local host = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local options = Options ?? { }
   options.flags ?= SCIF_EDIT
   options.lineHighlight ?= '255,255,255,0'
   local sci = host.new('Scintilla', options)
   sci.string = Text ?? DOCUMENT
   show(surface)
   surface.acFocus()
   processing.sleep(0)
   return surface, scene, host, sci
end

function topLine(Sci:obj):num
   return -Sci.page.y / LINE_HEIGHT
end

function cursorAt(Sci:obj!):str
   return f'{Sci.cursorRow}:{Sci.cursorCol}'
end

-- The SystemPointer is created with the first surface.

@BeforeEach function resetPointer()
   if obj.find('SystemPointer') then feed(JET_ABS_XY, 1000, 1000) end
end

----------------------------------------------------------------------------------------------------------------------
-- Positioning

@Test function ClickMovesCursor()
   local surface <close>, scene, host, sci = newEditor()

   clickAt(surface, 3, 1)
   assert(cursorAt(sci) is '1:3', f'A click must move the cursor to 1:3, at {cursorAt(sci)}')

   clickAt(surface, 40, 2)
   assert(cursorAt(sci) is '2:10', f'A click past the line end must move to the line end 2:10, at {cursorAt(sci)}')

   clickAt(surface, 2, 8)
   assert(cursorAt(sci) is '3:6', f'A click below the last line must move to the end, at {cursorAt(sci)}')
end

@Test function ClickInScrolledDocument()
   local text = ('x').rep(100)
   for i in {1 to 200} do text ..= '\n' .. ('x').rep(100) end
   local surface <close>, scene, host, sci = newEditor(nil, text)

   check sci.mtScrollToPoint(10 * GLYPH_WIDTH, 100 * LINE_HEIGHT)
   show(surface)
   assert(topLine(sci) is 100 and sci.page.x is -10 * GLYPH_WIDTH, 'The document must be scrolled for the test')

   clickAt(surface, 3, 2)
   assert(cursorAt(sci) is '102:13', f'A click must account for the scroll position, at {cursorAt(sci)}')
end

@Test function ClickOnFractionalHost()
   local surface <close> = obj.new('Surface', { width=PAGE_WIDTH, height=PAGE_HEIGHT })
   local scene = surface.new('VectorScene', { surface=surface })
   local root = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local host = root.new('VectorViewport', { x=10.5, y=20.25, width=200, height=80 })
   local sci = host.new('Scintilla', { flags=SCIF_EDIT, lineHighlight='255,255,255,0' })
   sci.string = DOCUMENT
   show(surface)

   feed(JET_ABS_XY, surface.absX + 10.5 + TEXT_LEFT + (5 * GLYPH_WIDTH) + 1, surface.absY + 20.25 + LINE_HEIGHT + 6)
   press()
   release()
   assert(cursorAt(sci) is '1:5', f'A click in an offset host must move the cursor to 1:5, at {cursorAt(sci)}')
end

-- Create a surface with two editors side by side, and drag from the left editor into the right one so that the
-- button is released over the right editor.  The right editor becomes the active vector without receiving a movement
-- event.

function dragIntoSecondEditor(Text:str):<obj, obj>
   local surface = obj.new('Surface', { width=PAGE_WIDTH * 2, height=PAGE_HEIGHT })
   local scene = surface.new('VectorScene', { surface=surface })
   local left_host = scene.new('VectorViewport', { x=0, y=0, width=PAGE_WIDTH, height='100%' })
   local right_host = scene.new('VectorViewport', { x=PAGE_WIDTH, y=0, width=PAGE_WIDTH, height='100%' })
   local left = left_host.new('Scintilla', { flags=SCIF_EDIT, lineHighlight='255,255,255,0' })
   local right = right_host.new('Scintilla', { flags=SCIF_EDIT, lineHighlight='255,255,255,0' })
   left.string = DOCUMENT
   right.string = Text ?? DOCUMENT
   show(surface)

   moveTo(surface, 2, 0)
   press()
   feed(JET_ABS_XY, cellX(surface, 5) + PAGE_WIDTH, cellY(surface, 1))
   release()
   return surface, right
end

@Test function ClickAfterDragIntoOtherEditor()
   local surface <close>, right = dragIntoSecondEditor()

   press()
   release()
   assert(cursorAt(right) is '1:5', f'A click without movement must use the pointer position, at {cursorAt(right)}')
end

@Test function ClickAfterWheelInOtherEditor()
   local text = 'line 0'
   for i in {1 to 100} do text ..= f'\nline {i}' end
   local surface <close>, right = dragIntoSecondEditor(text)

   feed(JET_WHEEL, 9, 0) -- One step down scrolls by 3 lines
   assert(topLine(right) is 3, f'The wheel must scroll the editor under the pointer, top line is {topLine(right)}')
   press()
   release()
   assert(cursorAt(right) is '4:5', f'A click after scrolling must account for the scroll, at {cursorAt(right)}')
end

----------------------------------------------------------------------------------------------------------------------
-- Selection

@Test function DragSelects()
   local surface <close>, scene, host, sci = newEditor()

   dragTo(surface, 6, 0, 7, 1)
   assert(cursorAt(sci) is '1:7', f'The cursor must follow the drag to 1:7, at {cursorAt(sci)}')
   deleteSelection()
   assert(sci.string is 'alpha line here\nthird line\nfourth', f'The dragged range must be selected, got "{sci.string}"')
end

@Test function DragBackwards()
   local surface <close>, scene, host, sci = newEditor()

   dragTo(surface, 10, 0, 6, 0)
   assert(cursorAt(sci) is '0:6', f'The cursor must follow the drag to 0:6, at {cursorAt(sci)}')
   deleteSelection()
   assert(sci.string.startsWith('alpha  gamma'), f'"beta" must be selected, got "{sci.string}"')
end

@Test function DoubleClickSelectsWord()
   local surface <close>, scene, host, sci = newEditor()

   multiClick(surface, 8, 0, 2)
   deleteSelection()
   assert(sci.string.startsWith('alpha  gamma\n'), f'A double click must select "beta", got "{sci.string}"')
end

@Test function TripleClickSelectsLine()
   local surface <close>, scene, host, sci = newEditor()

   multiClick(surface, 3, 1, 3)
   deleteSelection()
   assert(sci.string is 'alpha beta gamma\nthird line\nfourth', f'A triple click must select the line, got "{sci.string}"')
end

@Test function DoubleClickIntervalFollowsPointer()
   local pointer = obj.find('SystemPointer')
   local interval = pointer.doubleClick
   defer
      pointer.doubleClick = interval
   end

   local surface <close>, scene, host, sci = newEditor()

   -- Clicks that are further apart than the pointer's interval are separate clicks.

   pointer.doubleClick = 0.05
   clickAt(surface, 8, 0)
   processing.sleep(0.15)
   clickAt(surface, 8, 0)
   deleteSelection()
   assert(sci.string.startsWith('alpha bea gamma'), f'Slow clicks must not select a word, got "{sci.string}"')

   -- The same clicks are a double click under a longer interval.

   pointer.doubleClick = 1
   waitForClickInterval()
   clickAt(surface, 8, 0)
   processing.sleep(0.15)
   clickAt(surface, 8, 0)
   deleteSelection()
   assert(sci.string.startsWith('alpha  gamma'), f'Clicks within the interval must select a word, got "{sci.string}"')
end

@Test function ShiftClickExtendsFromAnchor()
   local surface <close>, scene, host, sci = newEditor()

   clickAt(surface, 6, 0)
   holdKey(KEY_L_SHIFT, KQ_L_SHIFT)
   clickAt(surface, 3, 1)
   clickAt(surface, 6, 1)  -- Extends from the original anchor, not from the previous click
   releaseKey(KEY_L_SHIFT)

   assert(cursorAt(sci) is '1:6', f'The cursor must be at the last click, at {cursorAt(sci)}')
   deleteSelection()
   assert(sci.string is 'alpha  line here\nthird line\nfourth', f'Shift+click must extend the selection, got "{sci.string}"')
end

@Test function ShiftReleaseEndsExtension()
   local surface <close>, scene, host, sci = newEditor()

   clickAt(surface, 6, 0)
   holdKey(KEY_L_SHIFT, KQ_L_SHIFT)
   releaseKey(KEY_L_SHIFT)
   clickAt(surface, 3, 1)
   deleteSelection()
   assert(sci.string is 'alpha beta gamma\nsecnd line here\nthird line\nfourth',
      f'A click after releasing Shift must not extend the selection, got "{sci.string}"')
end

@Test function AltDragSelectsRectangle()
   local surface <close>, scene, host, sci = newEditor()

   holdKey(KEY_L_ALT, KQ_L_ALT)
   dragTo(surface, 1, 0, 3, 2)
   releaseKey(KEY_L_ALT)
   deleteSelection()
   assert(sci.string is 'aha beta gamma\nsond line here\ntrd line\nfourth',
      f'Alt+drag must select a rectangle, got "{sci.string}"')
end

@Test function ClickInSelectionClearsIt()
   local surface <close>, scene, host, sci = newEditor()

   -- Text drag and drop is not supported, so a click inside the selection is an ordinary click.

   dragTo(surface, 0, 0, 10, 0)
   clickAt(surface, 3, 0)
   assert(cursorAt(sci) is '0:3', f'The click must move the cursor to 0:3, at {cursorAt(sci)}')
   deleteSelection()
   assert(sci.string.startsWith('alpa beta gamma'), f'The click must clear the selection, got "{sci.string}"')

   -- A drag that starts inside the selection makes a new selection rather than moving the text.

   check sci.mtSelectRange(0, 5)
   dragTo(surface, 2, 0, 6, 0)
   deleteSelection()
   assert(sci.string.startsWith('aleta gamma'), f'A drag inside the selection must select, got "{sci.string}"')
end

@Test function MarginClickSelectsLine()
   local surface <close>, scene, host, sci = newEditor({ lineNumbers=true })

   feed(JET_ABS_XY, surface.absX + 2, cellY(surface, 2))
   press()
   release()
   deleteSelection()
   assert(sci.string is 'alpha beta gamma\nsecond line here\nfourth', f'A margin click must select the line, got "{sci.string}"')
end

@Test function DragBeyondViewScrolls()
   local text = 'line 0'
   for i in {1 to 100} do text ..= f'\nline {i}' end
   local surface <close>, scene, host, sci = newEditor(nil, text)

   -- The scene keeps delivering movement to the editor while the button is held, and holding the pointer below the
   -- View keeps scrolling.

   moveTo(surface, 2, 2)
   press()
   feed(JET_ABS_XY, cellX(surface, 2), surface.absY + PAGE_HEIGHT + 20)
   processing.sleep(0.8)
   local top = topLine(sci)
   local row = sci.cursorRow
   assert(top > 0, f'Dragging below the View must scroll, top line is {top}')
   assert(row > top + 7, f'The selection must follow the scroll, cursor row is {row}')

   -- The release is reported at the position of the last movement, which preceded the scrolling.

   release()
   assert(topLine(sci) >= top, f'Releasing the button must not scroll back, top line is {topLine(sci)}')
   assert(sci.cursorRow >= row, f'The selection must end at the pointer, cursor row is {sci.cursorRow}')
   top = topLine(sci)
   processing.sleep(0.4)
   assert(topLine(sci) is top, f'Scrolling must stop when the button is released, top line is {topLine(sci)}')

   -- Dragging above the View scrolls back.

   moveTo(surface, 2, 4)
   press()
   assert(sci.cursorRow is top + 4, f'A click after scrolling must map to line {top + 4}, row is {sci.cursorRow}')
   feed(JET_ABS_XY, cellX(surface, 2), surface.absY - 20)
   processing.sleep(0.8)
   release()
   assert(topLine(sci) < top, f'Dragging above the View must scroll back, top line is {topLine(sci)}')
end

----------------------------------------------------------------------------------------------------------------------
-- States

@Test function CursorFollowsContent()
   local surface <close>, scene, host, sci = newEditor({ lineNumbers=true })
   local canvas = sci.page.child

   moveTo(surface, 3, 1)
   assert(canvas.cursor is PTC_TEXT, f'The text cursor must be shown over text, cursor is {canvas.cursor}')
   assert(surface.cursor is PTC_TEXT, f'The surface must show the text cursor, cursor is {surface.cursor}')

   feed(JET_ABS_XY, surface.absX + 2, cellY(surface, 1))
   assert(canvas.cursor is PTC_DEFAULT, f'The arrow must be shown over the margin, cursor is {canvas.cursor}')
   assert(surface.cursor is PTC_DEFAULT, f'The surface must show the arrow over the margin, cursor is {surface.cursor}')

   moveTo(surface, 3, 1)
   assert(canvas.cursor is PTC_TEXT, f'The text cursor must return over text, cursor is {canvas.cursor}')
   assert(surface.cursor is PTC_TEXT, f'The surface must show the text cursor, cursor is {surface.cursor}')

   -- Scintilla would show the arrow over a selection to offer text dragging, which is not supported.

   check sci.mtSelectRange(0, 30)
   moveTo(surface, 5, 0)
   assert(canvas.cursor is PTC_TEXT, f'The text cursor must be shown over a selection, cursor is {canvas.cursor}')
   assert(surface.cursor is PTC_TEXT, f'The surface must show the text cursor over a selection, cursor is ' ..
      f'{surface.cursor}')
end

@Test function ClickFocusesEditor()
   local surface <close>, scene, host, sci = newEditor()
   local other = scene.new('VectorViewport', { x=0, y=0, width=1, height=1 })
   other.acFocus()
   processing.sleep(0)

   clickAt(surface, 3, 1)
   sendKey(KEY_BACKSPACE, 0)
   assert(sci.string.startsWith('alpha beta gamma\nseond'), f'A click must focus the editor, got "{sci.string}"')
end

@Test function ClickFocusesCustomFocusViewport()
   local surface <close> = obj.new('Surface', { width=PAGE_WIDTH, height=PAGE_HEIGHT })
   local scene = surface.new('VectorScene', { surface=surface })
   local host = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local focus = scene.new('VectorViewport', { x=0, y=0, width=1, height=1 })
   local sci = host.new('Scintilla', { flags=SCIF_EDIT, focus=focus, lineHighlight='255,255,255,0' })
   sci.string = DOCUMENT
   show(surface)
   surface.acFocus()
   processing.sleep(0)

   clickAt(surface, 3, 1)
   sendKey(KEY_BACKSPACE, 0)
   assert(sci.string.startsWith('alpha beta gamma\nseond'),
      f'A click must focus the editor\'s Focus viewport, got "{sci.string}"')
end

@Test function DisabledEditorIgnoresPointer()
   local surface <close>, scene, host, sci = newEditor()

   clickAt(surface, 3, 1)
   check sci.acDisable()
   clickAt(surface, 5, 2)
   assert(cursorAt(sci) is '1:3', f'A disabled editor must ignore clicks, cursor is at {cursorAt(sci)}')

   check sci.acEnable()
   clickAt(surface, 5, 2)
   assert(cursorAt(sci) is '2:5', f'An enabled editor must accept clicks, cursor is at {cursorAt(sci)}')
end

@Test function DisableDuringDragStopsScrolling()
   local text = 'line 0'
   for i in {1 to 100} do text ..= f'\nline {i}' end
   local surface <close>, scene, host, sci = newEditor(nil, text)

   moveTo(surface, 2, 2)
   press()
   feed(JET_ABS_XY, cellX(surface, 2), surface.absY + PAGE_HEIGHT + 20)
   check sci.acDisable()
   local top = topLine(sci)
   processing.sleep(0.4)
   release()
   assert(topLine(sci) is top, f'A disabled editor must stop scrolling, top line is {topLine(sci)}')
end
